Notebook[{
Cell["A Probe for the Document View Controls", "Title",ExpressionUUID->"bc23760e-ea9e-4bcc-b946-4716fea634f1"],

Cell["MathNotebook", "Author",ExpressionUUID->"b0962196-0fef-4c47-95e7-46bc5d87acf9"],

Cell["T6 \[AHat]\.80\.94 feedback round", "Date",ExpressionUUID->"59ba6579-a4a0-487d-87fd-64dab7f652f9"],

Cell["\<\
Every style the three sliders are supposed to reach appears below exactly \
once, in the order the stylesheet declares them. Drag a slider and read down \
the page: a style that does not move is a defect, and the ones already known \
to stay put are named in the checklist.\
\>", "Abstract",ExpressionUUID->"3ea09334-19bb-459a-9d93-351a0194150f"],

Cell["Prose and Sectioning", "Section",ExpressionUUID->"ed220939-c7cb-4454-b852-a7efd5df6d2b"],

Cell["\<\
Body text, the anchor of the text slider. This paragraph is deliberately long \
enough to wrap several times at every size in the slider's range, because the \
number of wrapped lines is the only honest read on whether a font size \
actually changed \[AHat]\.80\.94 the glyphs alone are easy to misjudge by \
eye, and the column width changes the count too.\
\>", "Text",ExpressionUUID->"018be986-1ced-4aef-baf0-160ec91fab02"],

Cell["A Subsection", "Subsection",ExpressionUUID->"1eb62115-7ee7-409d-9fc7-e057a785b4e8"],

Cell["\<\
A second paragraph under a subsection, with inline mathematics \[Sum] \
\[Alpha] \[CenterDot] \[Beta] \[Element] \[DoubleStruckCapitalR] set in the \
body font, so prose and mathematics can be compared in one line.\
\>", "Text",ExpressionUUID->"7e63eb7c-43d6-4a2a-9300-fc959637bd3e"],

Cell["A Subsubsection", "Subsubsection",ExpressionUUID->"f5e7b729-fc20-471f-a206-c5b96759646c"],

Cell["Prose under a subsubsection.", "Text",ExpressionUUID->"a438b513-816d-4655-a627-3b663d08854c"],

Cell["Mathematics", "Section",ExpressionUUID->"d4ffed3a-3ca6-468e-a741-418ed4bbe283"],

Cell["\<\
An unnumbered display follows, then a numbered one. The equation number is \
its own style and has to grow with the mathematics, not with the prose.\
\>", "Text",ExpressionUUID->"0b1b2f88-c81c-43e4-bdc2-ea35fa5b6185"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[Integral]", "\[CapitalOmega]"], "d", "\[Omega]", "=", 
  SubscriptBox["\[Integral]", 
   RowBox[{"\[PartialD]", "\[CapitalOmega]"}]], 
  "\[Omega]"}]], "DisplayFormula",ExpressionUUID->"0011e278-6e8d-42f7-8636-\
c827f97a63a7"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[CapitalDelta]", "k"], "=", "d", 
  SuperscriptBox["d", "*"], "+", 
  SuperscriptBox["d", "*"], "d"}]], "DisplayFormulaNumbered",ExpressionUUID->\
"82bdbf92-7144-4ec7-8ead-8d1c5c1ff3cc"],

Cell["Environments", "Section",ExpressionUUID->"10c22cbe-f237-4208-93d3-8b2cffec025c"],

Cell["\<\
A plain-class environment. Its dingbat is drawn to the left of its own cell \
margin, so it is the style that reveals whether the column-width offsets keep \
the label on the page.\
\>", "Theorem",ExpressionUUID->"1ea7f16c-ae17-40c4-8766-6ce49a32c3fe"],

Cell["\<\
The proof style, which is declared to inherit from Text and therefore does \
not pick up a child sheet's override of Text \[AHat]\.80\.94 one of the two \
causes of the sizes that do not move.\
\>", "Proof",ExpressionUUID->"984a3b69-db0c-42ea-b6ef-8c8fe1627c2e"],

Cell["A definition-class environment, upright rather than italic.", \
"Definition",ExpressionUUID->"2b61867e-669b-42a9-98bc-4ac287569164"],

Cell["A remark-class environment, with an italic dingbat.", "Remark",ExpressionUUID->"dc17878b-87bc-465d-9191-fa6b283441d9"],

Cell["Lists", "Section",ExpressionUUID->"651d1c42-2ed5-4a2b-8e46-1417dfdc16d5"],

Cell["\<\
The three list styles come from Default.nb, not from LaTeXBase.nb.\
\>", "Text",ExpressionUUID->"775f6908-bdc6-4a29-8662-12adf6388710"],

Cell["An item.", "Item",ExpressionUUID->"24e57103-a320-488f-9dd8-6bab8b020bf3"],

Cell["A numbered item.", "ItemNumbered",ExpressionUUID->"d22384be-219f-47df-9e55-1528cc496d86"],

Cell["An item paragraph.", "ItemParagraph",ExpressionUUID->"5133f12a-7388-4423-80e0-2cedea2dfb04"],

Cell["References", "Section",ExpressionUUID->"616b698c-f54c-4b89-ac47-19d9c72bd32a"],

Cell["\<\
Ollivier, Ricci curvature of Markov chains on metric spaces, \
https://arxiv.org/abs/0810.5625\
\>", "Reference",ExpressionUUID->"153a4792-aa5d-4244-961e-04e09a5db943"],

Cell["\<\
Forman, Bochner's method for cell complexes and combinatorial Ricci \
curvature, Discrete Comput. Geom. 29 (2003) 323\[Dash]374\
\>", "Reference",ExpressionUUID->"3f9aaab2-4307-4785-866a-176612763494"]
},
WindowSize->{900, 800},
