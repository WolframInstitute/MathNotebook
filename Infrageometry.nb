Cell[BoxData[
 RowBox[{
  RowBox[{"CreatePalette", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Button", "[", 
       RowBox[{"\"\<Copy cell reference\>\"", ",", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"id", "=", 
            RowBox[{"CurrentValue", "[", 
             RowBox[{
              RowBox[{"First", "[", 
               RowBox[{
                RowBox[{"Cells", "[", 
                 RowBox[{
                  RowBox[{"NotebookSelection", "[", 
                   RowBox[{"InputNotebook", "[", "]"}], "]"}], ",", 
                  RowBox[{
                  "CellStyle", "->", "\"\<DisplayFormulaNumbered\>\""}]}], 
                 "]"}], ",", 
                RowBox[{
                 RowBox[{
                 "MessageDialog", "[", "\"\<Select an equation cell!\>\"", 
                  "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Return", "[", "]"}]}]}], "]"}], ",", "CellID"}], 
             "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"CopyToClipboard", "@", 
           RowBox[{"Button", "[", 
            RowBox[{
             RowBox[{"Row", "@", 
              RowBox[{"{", 
               RowBox[{"\"\<(\>\"", ",", 
                RowBox[{"Dynamic", "@", 
                 RowBox[{"CurrentValue", "[", 
                  RowBox[{
                   RowBox[{"First", "[", 
                    RowBox[{
                    RowBox[{"Cells", "[", 
                    RowBox[{"CellID", "->", "id"}], "]"}], ",", "$Failed"}], 
                    "]"}], ",", 
                   RowBox[{"{", 
                    
                    RowBox[{"\"\<CounterValue\>\"", 
                    ",", "\"\<DisplayFormulaNumbered\>\""}], "}"}]}], "]"}]}],
                 ",", "\"\<)\>\""}], "}"}]}], ",", 
             RowBox[{"NotebookFind", "[", 
              RowBox[{
               RowBox[{"InputNotebook", "[", "]"}], ",", "id", ",", "All", ",",
                "CellID"}], "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"BaseStyle", "->", "\"\<Link\>\""}], ",", 
             RowBox[{"Appearance", "->", "None"}]}], "\[IndentingNewLine]", 
            "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"DynamicModule", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"tag", "=", "None"}], "}"}], ",", 
        RowBox[{"Pane", "[", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Tag cell\>\"", ",", 
             RowBox[{"With", "[", 
