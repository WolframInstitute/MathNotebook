Cell["\<\
Put this code inside your init.m file \
(https://mathematica.stackexchange.com/questions/263698/how-to-write-latex-\
style-math-in-notebook-as-text/266146#266146). Modify if necessary.\
\>", "Text",
 CellChangeTimes->{{3.914082156054483*^9, 3.9140821844880333`*^9}, {
  3.914082239222836*^9, 3.914082239630722*^9}, {3.914082296059331*^9, 
  3.9140822968841543`*^9}, {3.914082749773632*^9, 
  3.914082756322048*^9}},ExpressionUUID->"72965c76-e05e-44af-85b8-\
2f2908563f54"],

Cell[BoxData[
 RowBox[{"SystemOpen", "[", "\"\<init.m\>\"", "]"}]], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"2b3f2cab-04b1-43cc-9431-eb2571643a2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "use", " ", "MaTeX", " ", "to", " ", "format", " ", "inline", " ", "TeX"}],
    "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"$useMaTeXMag", " ", "=", " ", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"$useMaTeXBaselineShift", " ", "=", " ", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"$MaTeXPreamble", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"InputAssistant`TeXStringToBoxes", " ", "//", " ", "Unprotect"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"InputAssistant`TeXStringToBoxes", "[", "s_String", "]"}], " ", 
      "/;", " ", 
      RowBox[{"TrueQ", "[", "$useMaTeXQ", "]"}]}], " ", ":=", "\n", "\t", 
     RowBox[{"AdjustmentBox", "[", "\n", "\t\t", 
      RowBox[{
       RowBox[{"ToBoxes", " ", "@", " ", 
        RowBox[{"MaTeX", "[", 
         RowBox[{"s", ",", " ", 
          RowBox[{"Magnification", " ", "->", " ", "$useMaTeXMag"}], ",", " ", 
          RowBox[{"\"\<Preamble\>\"", " ", "->", " ", "$MaTeXPreamble"}]}], 
         "]"}]}], ",", "\n", "\t\t", 
       RowBox[{
       "BoxBaselineShift", " ", "->", " ", "$useMaTeXBaselineShift"}]}], "\n",
       "\t", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"InputAssistant`TeXStringToBoxes", " ", "//", " ", "Protect"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"$useMaTeXQ", " ", "=", " ", "True"}], ";"}]}]}]], "Code",Expressi\
onUUID->"03372bcc-7096-4120-b300-938b87923446"],

Cell["So that it would look something like this:", "Text",
