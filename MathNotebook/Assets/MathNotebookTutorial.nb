Cell[9489, 259, 192, 3, 70, "Item",ExpressionUUID->"c3186024-3ffb-4330-8df6-6d7628c29a0e"],
Cell[9684, 264, 129, 0, 70, "Theorem",ExpressionUUID->"52797da3-9415-4bdb-993f-bfed7b5baeb4"],
Cell[9816, 266, 226, 6, 70, "DisplayFormulaNumbered",ExpressionUUID->"3a6d06cd-92c2-4b7d-aee7-0e87d59827ff"],
Cell[10045, 274, 85, 0, 70, "Section",ExpressionUUID->"5d53e272-0503-49a8-aafe-fa415f73d191"],
Cell[10133, 276, 594, 18, 70, "Item",ExpressionUUID->"0be0e5ee-9919-4126-99f0-49695c1b1047"],
Cell[10730, 296, 195, 3, 70, "Item",ExpressionUUID->"f6979008-27aa-468d-af9a-16de99d1f30d"],
