Notebook[{
Cell["Writing Mathematics in Notebooks", "Title",ExpressionUUID->"3cdbd96b-17b6-41c9-8367-3c02c049032d"],

Cell["MathNotebook Tutorial", "Author",ExpressionUUID->"ea93ae69-3133-46fe-8b22-2c31261603a2"],

Cell["\<\
How to write a mathematics paper in a Wolfram notebook: referencing, journal \
stylesheets, LaTeX conversion, and MaTeX rendering.\
\>", "Abstract",ExpressionUUID->"03a12e88-d16a-4212-86b0-673d03907120"],

Cell["Getting Started", "Section",ExpressionUUID->"4af9fa54-9b00-47d2-9be4-d38a9b36cd5e"],

Cell["Content to be written.", "Text",ExpressionUUID->"9095efb8-b8c4-4dde-a0bb-dc4f18cf154d"],

Cell["Referencing", "Section",ExpressionUUID->"a47ed45a-4f44-4797-be17-7f2d080dc422"],

Cell["Content to be written.", "Text",ExpressionUUID->"544ce0a3-d923-4d3a-9f3a-d63c5ff9e2be"],

Cell["Stylesheets", "Section",ExpressionUUID->"dcd6f4d2-b286-4dce-85e0-ea7f1a392cc0"],

Cell["Content to be written.", "Text",ExpressionUUID->"04786f49-0be2-4afa-ba5b-ae51bcd639c3"],

Cell["Math Input Shortcuts", "Section",ExpressionUUID->"9149fcca-410c-4858-84b4-161c4e5624ff"],

Cell[TextData[{
 StyleBox["Ctrl+9",
  FontWeight->"Bold"],
 " inline math in text, ",
 StyleBox["Ctrl+0",
  FontWeight->"Bold"],
 " exits."
}], "Item",ExpressionUUID->"d639d916-9c26-447f-becb-11f56d0391a7"],

Cell[TextData[{
 StyleBox["Ctrl+/",
  FontWeight->"Bold"],
 " fraction, ",
 StyleBox["Ctrl+2",
  FontWeight->"Bold"],
 " square root."
}], "Item",ExpressionUUID->"4a5c699b-b5a9-47c2-a7c5-9f63984b1559"],

Cell[TextData[{
 StyleBox["Ctrl+^",
  FontWeight->"Bold"],
 " superscript, ",
 StyleBox["Ctrl+_",
  FontWeight->"Bold"],
 " subscript, ",
 StyleBox["Ctrl+%",
  FontWeight->"Bold"],
 " switches between them."
}], "Item",ExpressionUUID->"96b055ab-ac4b-40c6-be4d-d79fc38d6fa9"],

Cell[TextData[{
 StyleBox["esc",
  FontWeight->"Bold"],
 " ",
 StyleBox["name",
  FontSlant->"Italic"],
 " ",
 StyleBox["esc",
  FontWeight->"Bold"],
 " enters symbols: ",
 StyleBox["a",
  FontSlant->"Italic"],
 " \[RightArrow] \[Alpha], ",
 StyleBox["el",
  FontSlant->"Italic"],
 " \[RightArrow] \[Element], ",
 StyleBox["->",
  FontSlant->"Italic"],
 " \[RightArrow] \[Rule]."
}], "Item",ExpressionUUID->"4e9109b4-1fbf-4666-8440-385703211963"],

Cell[TextData[{
 StyleBox["Cmd+Shift+E",
  FontWeight->"Bold"],
 " shows the cell expression (",
 StyleBox["Ctrl+Shift+E",
  FontWeight->"Bold"],
 " on Windows)."
}], "Item",ExpressionUUID->"b62c4990-c24e-40d1-bd2f-ab313e8ec383"],

Cell["Working with Cells", "Section",ExpressionUUID->"18db9ead-06c3-4564-9fa8-9dc016086cc8"],

Cell[TextData[{
 "Click a cell bracket to select the cell; drag across brackets to select \
several; ",
 StyleBox["Delete",
  FontWeight->"Bold"],
 " removes them."
}], "Item",ExpressionUUID->"cdec83c8-f4c5-4cc6-82e7-93282164c6c0"],

Cell[TextData[{
 StyleBox["Ctrl+.",
  FontWeight->"Bold"],
 " extends the selection outward; repeat to reach the whole cell."
}], "Item",ExpressionUUID->"2f1cc65d-8adc-4f94-a801-6260470606d4"],

Cell[TextData[{
 StyleBox["Cmd+1",
  FontWeight->"Bold"],
 "/",
 StyleBox["4",
  FontWeight->"Bold"],
 "/",
 StyleBox["5",
  FontWeight->"Bold"],
 "/",
 StyleBox["7",
  FontWeight->"Bold"],
 "/",
 StyleBox["9",
  FontWeight->"Bold"],
 " restyle a cell: Title, Section, Subsection, Text, Input."
}], "Item",ExpressionUUID->"2a7c4d26-1b86-4131-a2a3-5464367128f1"],

Cell[TextData[{
 StyleBox["Cmd+Shift+D",
  FontWeight->"Bold"],
 " divides a cell at the cursor; ",
 StyleBox["Cmd+Shift+M",
  FontWeight->"Bold"],
 " merges selected cells."
}], "Item",ExpressionUUID->"11718d98-2a66-4ded-ad33-ce7d7b23f55e"],

Cell[TextData[{
 StyleBox["Ctrl+G",
  FontWeight->"Bold"],
 " groups selected cells; ",
 StyleBox["Ctrl+Shift+G",
  FontWeight->"Bold"],
 " ungroups."
}], "Item",ExpressionUUID->"e8b1ea6d-82a1-4635-b62d-4bd65f638dbf"],

Cell[TextData[{
 "Double-click a group bracket to close or open the group; ",
 StyleBox["Cmd+Shift+{",
  FontWeight->"Bold"],
 " and ",
 StyleBox["Cmd+Shift+}",
  FontWeight->"Bold"],
 " open and close all subgroups."
}], "Item",ExpressionUUID->"8241c9d1-f2ab-4cb0-9f4a-3e821d797a33"],

Cell["\<\
Double-click a closed group's remaining bracket to reopen it; use Cell \
\[RightArrow] Delete All Output before sharing a notebook.\
\>", "Item",ExpressionUUID->"9eb0d76a-3f4d-41db-9160-490497dd78e0"],

Cell["LaTeX Conversion", "Section",ExpressionUUID->"32140833-80f2-44e6-b314-d62c47aeea8a"],

Cell["Content to be written.", "Text",ExpressionUUID->"9917883d-cfdc-4f08-b02a-4c0e5cd6946b"],

Cell["MaTeX", "Section",ExpressionUUID->"dd6699c4-6463-47d7-9979-9bb5a905a7bc"],

Cell["Content to be written.", "Text",ExpressionUUID->"2fbbdb0e-34d2-4a02-8b01-68018c99ffd4"],

Cell["Best Practices", "Section",ExpressionUUID->"46dd6195-743d-48fc-9dc8-4bed14b7960a"],

Cell["Content to be written.", "Text",ExpressionUUID->"c53e2b6f-c27a-4278-95a7-044fda822920"]
},
