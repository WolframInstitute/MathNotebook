Cell[4760, 143, 381, 14, 70, "Item",ExpressionUUID->"ef975d77-31b6-4325-b35d-e1b78d479a99"],
Cell[5144, 159, 195, 3, 70, "Item",ExpressionUUID->"7613aa02-3be3-42a1-86ba-e940ab5f945b"],
Cell[5342, 164, 345, 5, 70, "Item",ExpressionUUID->"0da2fd9f-bb3e-4fd8-9c92-7a8ff29b62ba"],
Cell[5690, 171, 376, 14, 70, "Item",ExpressionUUID->"a1c48c08-4510-4386-8dc7-718209419668"],
