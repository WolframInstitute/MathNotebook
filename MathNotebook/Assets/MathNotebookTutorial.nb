Cell["Math Input Shortcuts", "Section",ExpressionUUID->"5ecf4b0c-c5f1-420c-b029-7c8ca394735c"],

Cell["\<\
Ctrl+9 starts an inline math cell inside a text cell; Ctrl+0 exits it.\
\>", "Item",ExpressionUUID->"5cf465fd-18b5-4489-880f-49aa8baa7334"],

Cell["\<\
Ctrl+/ fraction, Ctrl+^ superscript, Ctrl+_ subscript, Ctrl+2 square root.\
\>", "Item",ExpressionUUID->"825e4041-8032-446a-90b7-1e8c9af8d7b6"],

Cell["\<\
Esc-name-Esc enters symbols: esc a esc gives \[Alpha], esc el esc gives \
\[Element], esc -> esc gives \[Rule].\
\>", "Item",ExpressionUUID->"81a30ae4-1703-490b-bad8-248d116b3267"],

Cell["\<\
Cmd+Shift+E toggles the underlying cell expression (Ctrl+Shift+E on Windows \
and Linux).\
\>", "Item",ExpressionUUID->"639cdf5c-9873-4e41-8296-7105d8029544"],

Cell["Content to be written.", "Text",ExpressionUUID->"5abf85f2-f8fd-4a36-98d2-a2de5f475525"],

