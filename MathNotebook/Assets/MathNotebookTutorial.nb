Cell[12180, 336, 567, 11, 70, "Item",ExpressionUUID->"af6d3d6c-7310-4056-9c7d-de824a74e28c"],
Cell[12750, 349, 594, 13, 70, "Item",ExpressionUUID->"306d66b6-957c-4271-883a-d71f93c0db37"],
Cell[13347, 364, 105, 0, 70, "Section",ExpressionUUID->"8ee86265-04a6-4045-b7fc-536bce58e6e8"],
Cell[13455, 366, 272, 4, 70, "Item",ExpressionUUID->"a1f4224b-7255-4718-8773-d2967c014887"],
Cell[13730, 372, 340, 7, 70, "Item",ExpressionUUID->"684d5459-7593-4cac-8a6f-104069dbbf7d"],
