(* Beginning of Notebook Content *)
Notebook[{
Cell["Writing Mathematics in Notebooks", "Title",ExpressionUUID->"d824ba4e-ebef-4d86-81ca-9b5ec99b7e7b"],

Cell["MathNotebook Tutorial", "Author",ExpressionUUID->"4757ec1f-432f-43e9-a1fb-a053df4a7350"],

Cell["\<\
How to write a mathematics paper in a Wolfram notebook: journal stylesheets, \
live referencing, and conversion between LaTeX source and native typeset \
math. Whether the mathematics is written as LaTeX or as built-in typeset math \
is your choice throughout \[LongDash] the palette only moves a selection from \
one to the other.\
\>", "Abstract",ExpressionUUID->"647e7ef1-ead8-4ada-90e1-fd4cb5212709"],

Cell["Getting Started", "Section",ExpressionUUID->"6d7c110c-2afb-4798-8c8c-08b41acbbbff"],

Cell[TextData[{
 "After installing the paclet, restart the front end so that ",
 StyleBox["Palettes \[RightArrow] MathNotebook",
  FontSlant->"Italic"],
 " and the stylesheet menu appear."
}], "Item",ExpressionUUID->"c7892720-0bad-4975-8644-5a1a68d6f2cc"],

Cell[TextData[{
 "Give a notebook a journal style with ",
 StyleBox["Format \[RightArrow] Stylesheet \[RightArrow] MathNotebook",
  FontSlant->"Italic"],
 ", or the palette's ",
 StyleBox["Apply stylesheet",
  FontSlant->"Italic"],
 " menu; ",
 StyleBox["Default",
  FontSlant->"Italic"],
 " in that menu takes it back."
}], "Item",ExpressionUUID->"850e2b51-ee25-4300-8340-57a4b56a6a43"],

Cell[TextData[{
 "Style the opening cells ",
 StyleBox["Title",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Author",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Abstract",
  FontSlant->"Italic"],
 ", then write in ",
 StyleBox["Section",
  FontSlant->"Italic"],
 " and ",
 StyleBox["Text",
  FontSlant->"Italic"],
 " cells."
}], "Item",ExpressionUUID->"64d2cfce-c9f4-4890-adab-a96a76def334"],

Cell["\<\
Every palette button acts on the notebook you were last editing, and on its \
current selection.\
\>", "Item",ExpressionUUID->"5850d325-4c82-4f02-8878-8afeb07f99cc"],

Cell["\<\
The journal stylesheets are light-only; applying one from the palette also \
sets the notebook to light mode, so printed and exported output matches the \
screen.\
\>", "Item",ExpressionUUID->"82715088-9662-4f52-b2af-1b122942d217"],

Cell["Referencing", "Section",ExpressionUUID->"28b64171-2720-47d0-991e-a8b31c485653"],

Cell[TextData[{
 "Select a numbered cell \[LongDash] an equation, a theorem, a section, a \
numbered item \[LongDash] and press ",
 StyleBox["Copy reference",
  FontSlant->"Italic"],
 ", then paste into your text."
}], "Item",ExpressionUUID->"2df09555-14ad-4207-a81f-55ad85a4c1a8"],

Cell["\<\
The pasted reference is a live button showing the current number, so \
reordering cells renumbers every reference to them.\
\>", "Item",ExpressionUUID->"33cd2e9c-b5ad-4411-ac52-b2854a43b949"],

Cell[TextData[{
 "Clicking a reference jumps to its target; ",
 StyleBox["\[UpArrow] Go back",
  FontSlant->"Italic"],
 " returns to where you clicked from."
}], "Item",ExpressionUUID->"de7b9a6f-fa4e-4b3e-aa1e-fc07906044ab"],

Cell[TextData[{
 StyleBox["Tag cell",
  FontSlant->"Italic"],
 " names a cell, and ",
 StyleBox["Insert citation",
  FontSlant->"Italic"],
 " inserts a red bracketed link to that name \[LongDash] the two together \
give a bibliography: style each entry ",
 StyleBox["Reference",
  FontSlant->"Italic"],
 ", tag it, cite it."
}], "Item",ExpressionUUID->"bb2a9f71-b66a-4868-abb4-e5f9d840b219"],

Cell[TextData[{
 "Existing tags are listed under ",
 StyleBox["Cell \[RightArrow] Cell Tags",
  FontSlant->"Italic"],
 "."
}], "Item",ExpressionUUID->"d9e94ef3-2ab5-463b-9147-b0f6d2d3f78f"],

Cell["\<\
The theorem below and the equation after it are practice targets: select \
either one and copy a reference to it.\
\>", "Item",ExpressionUUID->"9168a0dd-85f8-4b6a-a73d-f1b42ee249bc"],

Cell["The exponential map is surjective onto the unit circle.", "Theorem",ExpressionUUID->"aa8f4342-0951-462b-86f4-9b0f2c3b3957"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["e", 
    RowBox[{"\[ImaginaryI]", "\[Pi]"}]], "+", "1", "=", "0"}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"d6ff7e15-339c-\
47ad-8523-a12ddc5ce5cf"],

Cell["Stylesheets", "Section",ExpressionUUID->"d74473b0-0a83-4dc0-a0ac-380956b5db5d"],

Cell[TextData[{
 "Four templates: ",
 StyleBox["AMSArticle",
  FontSlant->"Italic"],
 " (amsart, Palatino), ",
 StyleBox["ArXivArticle",
  FontSlant->"Italic"],
 " (article, Latin Modern), ",
 StyleBox["SpringerJournal",
  FontSlant->"Italic"],
 " and ",
 StyleBox["RevTeXAPS",
  FontSlant->"Italic"],
 " (Times)."
}], "Item",ExpressionUUID->"b58ddc1a-cad6-4f1c-ada3-8e87893d1141"],

Cell["\<\
All four define the same style names, so switching between them is instant \
and changes nothing but the typography.\
\>", "Item",ExpressionUUID->"a40ce2a0-6467-4664-98bb-93378bb4efb7"],

Cell["\<\
Theorem, Lemma, Proposition, Corollary, Conjecture, Claim, Definition, \
Example, Construction, Remark, Question, and Observation share a single \
counter that resets at each section, exactly as in LaTeX; numbered equations \
count continuously through the document.\
\>", "Item",ExpressionUUID->"5aca59c8-4e01-4878-8359-2fd63850c96b"],

Cell[TextData[{
 "Insert environments from the palette's ",
 StyleBox["Insert environment",
  FontSlant->"Italic"],
 " menu, or with the ",
 StyleBox["Proof",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Equation",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["Equation (n)",
  FontSlant->"Italic"],
 " buttons."
}], "Item",ExpressionUUID->"50596970-1e4c-4d42-9585-b650a9255cd1"],

Cell[TextData[{
 "Latin Modern and TeX Gyre are LaTeX fonts, not system fonts: press ",
 StyleBox["Install LaTeX fonts",
  FontSlant->"Italic"],
 " once to copy them out of a local TeX distribution (",
 ButtonBox["tug.org/texlive",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/texlive/"], None},
  ButtonNote->"https://tug.org/texlive/"],
 ") into your user font directory, then restart the front end. They are \
installed for the whole machine, not inside Mathematica, so any application \
can use them."
}], "Item",ExpressionUUID->"c00ff03b-06ed-4f65-b6e1-4e7d16aff51c"],

Cell["Reading and Writing Comfortably", "Section",ExpressionUUID->"f993be5f-212e-41aa-8ff7-f7fefa288b28"],

Cell["\<\
Each palette group folds: click its opener or its name to collapse it, so \
only the buttons you are using take up room. The palette remembers which \
groups are open across front end restarts.\
\>", "Item",ExpressionUUID->"a7eb7d7b-ffc6-4bf8-9105-378217256a4b"],

Cell[TextData[{
 "The ",
 StyleBox["Document view",
  FontSlant->"Italic"],
 " group holds three sliders and a reset. Like every other palette control \
they act on the notebook you were last editing, so leave the palette open \
beside your paper and drag while you read it."
}], "Item",ExpressionUUID->"24b87234-59ab-4c86-876d-e575ed535cd5"],

Cell[TextData[{
 StyleBox["Text size",
  FontSlant->"Italic"],
 " sets the size of ",
 StyleBox["Text",
  FontSlant->"Italic"],
 " and scales the title, the headings, and the abstract with it, so the \
document keeps its proportions instead of one style growing alone."
}], "Item",ExpressionUUID->"4706c2be-a93f-47c9-adea-2341024858b4"],

Cell[TextData[{
 StyleBox["Math size",
  FontSlant->"Italic"],
 " does the same for displayed equations and their numbers, independently of \
the prose \[LongDash] the usual reason to reach for it is an equation left \
too small to read beside text you have just enlarged."
}], "Item",ExpressionUUID->"42cf769a-164c-4654-b24d-aa911b07fbd6"],

Cell[TextData[{
 StyleBox["Column width",
  FontSlant->"Italic"],
 " is the width of the content column in points, centered in the page \
\[LongDash] an absolute measure, the same on screen as on paper, so a column \
set to 340 pt prints 340 pt wide whatever the paper is. At the top of the \
slider the column is ",
 StyleBox["Full",
  FontSlant->"Italic"],
 ", the unconstrained page the stylesheets already give you; every step below \
that is the short line a printed page has, which is what makes a paper \
readable on a wide screen. Section numbers and the theorem and abstract \
dingbats keep hanging in the margin at every width."
}], "Item",ExpressionUUID->"b000aba8-e783-4be0-bb9a-e2e48b1b9e64"],

Cell[TextData[{
 "All three set real font sizes and margins, so they reach the exported PDF. ",
 StyleBox["Format \[RightArrow] Magnification",
  FontSlant->"Italic"],
 " is a different thing entirely \[LongDash] it zooms the screen and never \
changes print."
}], "Item",ExpressionUUID->"4a8d245e-5f37-41c1-a3f7-10b96c16c355"],

Cell["\<\
The settings are stored in the notebook itself, so they survive saving and \
reopening and travel with the file to a coauthor.\
\>", "Item",ExpressionUUID->"72be80d4-2c9b-481a-a776-1ccc6200ccf4"],

Cell[TextData[{
 StyleBox["Reset view",
  FontSlant->"Italic"],
 " returns the notebook to its stylesheet defaults and leaves no trace of the \
overrides; applying a stylesheet clears them too, since the new sheet \
replaces them."
}], "Item",ExpressionUUID->"d3f809ea-4f33-47dc-b491-8af555dd176d"],

Cell[TextData[{
 "MaTeX cells are images and cannot inherit a style, so ",
 StyleBox["Math size",
  FontSlant->"Italic"],
 " re-renders each of them through LaTeX at the new size, from the TeX the \
cell stores."
}], "Item",ExpressionUUID->"24d49ab5-937a-472b-8114-f42aeb5a964a"],

Cell[TextData[{
 "The same from code, on any notebook: ",
 StyleBox["SetDocumentFontSize[nb, 16]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["SetMathFontSize[nb, 16]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["SetContentWidth[nb, 340]",
  FontSlant->"Italic"],
 " \[LongDash] each takes ",
 StyleBox["Automatic",
  FontSlant->"Italic"],
 " to drop its own override, and the width also takes ",
 StyleBox["Full",
  FontSlant->"Italic"],
 " \[LongDash] and ",
 StyleBox["ResetDocumentView[nb]",
  FontSlant->"Italic"],
 " to drop all of them. They work on a notebook still using ",
 StyleBox["Default",
  FontSlant->"Italic"],
 " too."
}], "Item",ExpressionUUID->"e7ad41af-a268-4cde-84f0-043e193a074e"],

Cell["Math Input Shortcuts", "Section",ExpressionUUID->"979b1ae5-ecdd-479a-b74f-6e72bf61968c"],

Cell[TextData[{
 StyleBox["Ctrl+9",
  FontWeight->"Bold"],
 " inline math in text, ",
 StyleBox["Ctrl+0",
  FontWeight->"Bold"],
 " exits."
}], "Item",ExpressionUUID->"57e1d957-b357-438b-9033-f8d861c0085c"],

Cell[TextData[{
 StyleBox["Ctrl+/",
  FontWeight->"Bold"],
 " fraction, ",
 StyleBox["Ctrl+2",
  FontWeight->"Bold"],
 " square root."
}], "Item",ExpressionUUID->"11c7895b-25ec-4ad1-8dc8-58c8ce8f275e"],

Cell[TextData[{
 StyleBox["Ctrl+^",
  FontWeight->"Bold"],
 " superscript, ",
 StyleBox["Ctrl+_",
  FontWeight->"Bold"],
 " subscript, ",
 StyleBox["Ctrl+%",
  FontWeight->"Bold"],
 " switches between them."
}], "Item",ExpressionUUID->"65a82779-12f7-4d2f-8590-9a2af55a38cf"],

Cell[TextData[{
 StyleBox["esc",
  FontWeight->"Bold"],
 " ",
 StyleBox["name",
  FontSlant->"Italic"],
 " ",
 StyleBox["esc",
  FontWeight->"Bold"],
 " enters symbols: ",
 StyleBox["a",
  FontSlant->"Italic"],
 " \[RightArrow] \[Alpha], ",
 StyleBox["el",
  FontSlant->"Italic"],
 " \[RightArrow] \[Element], ",
 StyleBox["->",
  FontSlant->"Italic"],
 " \[RightArrow] \[Rule]."
}], "Item",ExpressionUUID->"eefa3f72-8807-4e3e-b974-0be39b3df43b"],

Cell[TextData[{
 StyleBox["Cmd+Shift+E",
  FontWeight->"Bold"],
 " shows the cell expression (",
 StyleBox["Ctrl+Shift+E",
  FontWeight->"Bold"],
 " on Windows)."
}], "Item",ExpressionUUID->"cc54608d-0d4b-4c2a-83b5-2c6babec283f"],

Cell["Working with Cells", "Section",ExpressionUUID->"25a87ebc-c120-42a6-8776-5cce1c4ab3db"],

Cell[TextData[{
 "Click a cell bracket to select the cell; drag across brackets to select \
several; ",
 StyleBox["Delete",
  FontWeight->"Bold"],
 " removes them."
}], "Item",ExpressionUUID->"515e93fa-ed02-4ff6-9282-8dae603a2389"],

Cell[TextData[{
 StyleBox["Ctrl+.",
  FontWeight->"Bold"],
 " extends the selection outward; repeat to reach the whole cell."
}], "Item",ExpressionUUID->"d764bbe5-4ba7-45b7-9e6d-1f0db70997da"],

Cell[TextData[{
 StyleBox["Cmd+1",
  FontWeight->"Bold"],
 "/",
 StyleBox["4",
  FontWeight->"Bold"],
 "/",
 StyleBox["5",
  FontWeight->"Bold"],
 "/",
 StyleBox["7",
  FontWeight->"Bold"],
 "/",
 StyleBox["9",
  FontWeight->"Bold"],
 " restyle a cell: Title, Section, Subsection, Text, Input."
}], "Item",ExpressionUUID->"0972716c-3ad0-4fd8-80b8-13b48bcaf7bb"],

Cell[TextData[{
 StyleBox["Cmd+Shift+D",
  FontWeight->"Bold"],
 " divides a cell at the cursor; ",
 StyleBox["Cmd+Shift+M",
  FontWeight->"Bold"],
 " merges selected cells."
}], "Item",ExpressionUUID->"c1035c50-87a7-4f18-bf3c-642911543142"],

Cell[TextData[{
 StyleBox["Ctrl+G",
  FontWeight->"Bold"],
 " groups selected cells; ",
 StyleBox["Ctrl+Shift+G",
  FontWeight->"Bold"],
 " ungroups."
}], "Item",ExpressionUUID->"8301aa0e-c606-4bc7-96ce-2ea6c7ae2a67"],

Cell[TextData[{
 "Double-click a group bracket to close or open the group; ",
 StyleBox["Cmd+Shift+{",
  FontWeight->"Bold"],
 " and ",
 StyleBox["Cmd+Shift+}",
  FontWeight->"Bold"],
 " open and close all subgroups."
}], "Item",ExpressionUUID->"2baf41a4-51d9-44bf-ad14-2aad7c852b87"],

Cell["\<\
Double-click a closed group's remaining bracket to reopen it; use Cell \
\[RightArrow] Delete All Output before sharing a notebook.\
\>", "Item",ExpressionUUID->"f8498852-1ada-4c0c-b7de-772c86d4709d"],

Cell["LaTeX Conversion", "Section",ExpressionUUID->"79228a55-c6e2-41f0-98e9-431bb7d666ec"],

Cell[TextData[{
 "Select the cells to convert, then press ",
 StyleBox["TeX \[Rule] math",
  FontSlant->"Italic"],
 " or ",
 StyleBox["Math \[Rule] TeX",
  FontSlant->"Italic"],
 ". With nothing selected the whole notebook is converted."
}], "Item",ExpressionUUID->"5a177bf7-aa2a-430d-bdcc-1ef602e17e05"],

Cell[TextData[{
 StyleBox["TeX \[Rule] math",
  FontSlant->"Italic"],
 " parses inline ",
 StyleBox["$\[Ellipsis]$",
  FontSlant->"Italic"],
 " and ",
 StyleBox["\\(\[Ellipsis]\\)",
  FontSlant->"Italic"],
 ", and displayed ",
 StyleBox["$$\[Ellipsis]$$",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\\[\[Ellipsis]\\]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["equation",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["align",
  FontSlant->"Italic"],
 "; the starred forms stay unnumbered, the unstarred ones become numbered \
equations."
}], "Item",ExpressionUUID->"17f706a9-c1cf-457d-9a55-d657b77ce91d"],

Cell[TextData[{
 "An ",
 StyleBox["align",
  FontSlant->"Italic"],
 " environment becomes a grid aligned on its ",
 StyleBox["&",
  FontSlant->"Italic"],
 ", so it stays editable as one equation cell."
}], "Item",ExpressionUUID->"6c1a4171-c3cb-4119-a0a2-0be16e466a21"],

Cell[TextData[{
 "Each converted cell keeps its original TeX, so ",
 StyleBox["Math \[Rule] TeX",
  FontSlant->"Italic"],
 " gives back what you typed rather than a re-serialization of the boxes. \
Anything the parser cannot read is left untouched."
}], "Item",ExpressionUUID->"a59a8894-a40d-426a-80e9-62bb8a0eab5a"],

Cell[TextData[{
 "Input, Code, and Output cells are skipped, so ",
 StyleBox["$",
  FontSlant->"Italic"],
 " in code is safe. To bring in a LaTeX paper, paste it as Text cells and \
convert."
}], "Item",ExpressionUUID->"f7538172-dc4a-4506-bbda-0a0a10303156"],

Cell["MaTeX", "Section",ExpressionUUID->"cb339dc8-5c17-45e7-8351-ee5d806ec98a"],

Cell[TextData[{
 "MaTeX (",
 ButtonBox["github.com/szhorvat/MaTeX",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/szhorvat/MaTeX"], None},
  ButtonNote->"https://github.com/szhorvat/MaTeX"],
 ") is optional, and needs a TeX distribution and Ghostscript. It is used \
only by the MaTeX buttons; referencing, stylesheets, and LaTeX conversion do \
not."
}], "Item",ExpressionUUID->"58d7b2e5-3bbe-4bc9-9e5f-4cfe0efbbcb9"],

Cell[TextData[{
 "Use it when an equation has to come out of real LaTeX \[LongDash] macros, \
",
 StyleBox["tikz-cd",
  FontSlant->"Italic"],
 " diagrams, exact journal metrics."
}], "Item",ExpressionUUID->"b3713a49-ce20-4f47-8046-0e56f3dea4d1"],

Cell[TextData[{
 StyleBox["Install MaTeX",
  FontSlant->"Italic"],
 " installs the paclet and points it at the local ",
 StyleBox["pdflatex",
  FontSlant->"Italic"],
 " and ",
 StyleBox["gs",
  FontSlant->"Italic"],
 "."
}], "Item",ExpressionUUID->"22210ca0-20c6-489a-a39d-3686ccb5106c"],

Cell[TextData[{
 StyleBox["Math \[Rule] MaTeX",
  FontSlant->"Italic"],
 " renders the selected display equations through LaTeX; ",
 StyleBox["MaTeX \[Rule] math",
  FontSlant->"Italic"],
 " restores editable typeset math from the TeX stored in each cell."
}], "Item",ExpressionUUID->"7fd901cf-df72-43b7-a9c6-5b154d220b8f"],

Cell[TextData[{
 StyleBox["MaTeX preferences",
  FontSlant->"Italic"],
 " opens your ",
 StyleBox["init.m",
  FontSlant->"Italic"],
 " in the front end \[LongDash] deliberately not through the system handler \
for ",
 StyleBox[".m",
  FontSlant->"Italic"],
 " files. Set the preamble, the magnification, and ",
 StyleBox["$useMaTeXQ = True",
  FontSlant->"Italic"],
 " to route TeX typed into a notebook through LaTeX instead of the built-in \
parser."
}], "Item",ExpressionUUID->"0f4f50fa-92bf-4719-af78-22ee5b079e73"],

Cell["\<\
MaTeX cells are images: convert them back before editing, and keep rendering \
for last.\
\>", "Item",ExpressionUUID->"b1b212b7-2086-4378-9c63-7897ba0e00b4"],

Cell["Best Practices", "Section",ExpressionUUID->"6bd80cdf-975a-4f55-b34b-d49d53622e7c"],

Cell["\<\
One environment per cell, inserted from the palette, keeps the styles and \
counters consistent.\
\>", "Item",ExpressionUUID->"39b31393-9e11-4977-90bb-d8c4e86af18f"],

Cell["\<\
Tag cells as you write them; tagging a theorem after fifty pages means \
finding it again.\
\>", "Item",ExpressionUUID->"f60b9d28-9f92-4579-a3df-ab4ac3402cf1"],

Cell["\<\
Do not strip cell tagging rules: they hold the TeX source that makes the \
round trip lossless.\
\>", "Item",ExpressionUUID->"a5b95b38-cb8b-479c-94a6-5d7ce6190aca"],

Cell["\<\
Convert to LaTeX at submission time, not continuously \[LongDash] the \
notebook is the source.\
\>", "Item",ExpressionUUID->"c89244f1-a6c9-4f43-a17e-e96301082dd7"],

Cell[TextData[{
 "Before sharing: ",
 StyleBox["Cell \[RightArrow] Delete All Output",
  FontSlant->"Italic"],
 ", and convert MaTeX cells back to math so a coauthor can edit them."
}], "Item",ExpressionUUID->"532d1eea-1de0-48e2-9ef8-484954930a9c"],

Cell["Credits", "Section",ExpressionUUID->"8a1321cc-c7fc-4221-805f-397d54c28a0d"],

Cell[TextData[{
 "The referencing scheme and the MaTeX integration are originally due to Nik \
Murzin, ",
 ButtonBox["github.com/sw1sh",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/sw1sh"], None},
  ButtonNote->"https://github.com/sw1sh"],
 "; this paclet packages and extends that work."
}], "Text",ExpressionUUID->"ccf19a1c-6403-457d-b8e9-5cf5eea9f536"],

Cell[TextData[{
 "Nik Murzin, ",
 ButtonBox["https://github.com/sw1sh",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/sw1sh"], None},
  ButtonNote->"https://github.com/sw1sh"]
}], "Reference",ExpressionUUID->"13aaf0f5-a26a-4dda-a1e6-1457e72ede14"],

Cell[TextData[{
 "Szabolcs Horvat, MaTeX: LaTeX labels in Mathematica, ",
 ButtonBox["https://github.com/szhorvat/MaTeX",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/szhorvat/MaTeX"], None},
  ButtonNote->"https://github.com/szhorvat/MaTeX"]
}], "Reference",ExpressionUUID->"753213ca-0f5d-4a14-a720-d3fb0c6471b3"],

Cell[TextData[{
 "TeX Live, ",
 ButtonBox["https://tug.org/texlive/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/texlive/"], None},
  ButtonNote->"https://tug.org/texlive/"],
 " \[LongDash] on macOS, MacTeX, ",
 ButtonBox["https://tug.org/mactex/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/mactex/"], None},
  ButtonNote->"https://tug.org/mactex/"]
}], "Reference",ExpressionUUID->"366cc76b-fb3f-4c9f-bbc3-659b776420b2"],

Cell[TextData[{
 "Latin Modern, ",
 ButtonBox["https://ctan.org/pkg/lm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://ctan.org/pkg/lm"], None},
  ButtonNote->"https://ctan.org/pkg/lm"],
 " and TeX Gyre, ",
 ButtonBox["https://ctan.org/pkg/tex-gyre",
  BaseStyle->"Hyperlink",
