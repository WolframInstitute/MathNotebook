Cell["Math Input Shortcuts", "Section",ExpressionUUID->"8eb8a4b0-cd12-49c8-8dfc-33119ef9752e"],

Cell["\<\
Ctrl+9 starts an inline math cell inside a text cell; Ctrl+0 exits it.\
\>", "Item",ExpressionUUID->"80a343f4-2fcf-48b8-982d-b3c332b63cfe"],

Cell["\<\
Ctrl+/ fraction, Ctrl+^ superscript, Ctrl+_ subscript, Ctrl+2 square root.\
\>", "Item",ExpressionUUID->"f74faa31-2bab-4fe1-8ef2-aec0e549ddbd"],

Cell["\<\
Esc-name-Esc enters symbols: esc a esc gives \[Alpha], esc el esc gives \
\[Element], esc -> esc gives \[Rule].\
\>", "Item",ExpressionUUID->"18f590c0-9b6d-445c-aea2-ddc09ffea64d"],

Cell["Ctrl+Shift+E toggles the underlying cell expression.", "Item",ExpressionUUID->"4f7699de-0c54-422a-a62f-38de223647ba"],

