Cell[TextData[{
 "TeX Live, ",
 ButtonBox["https://tug.org/texlive/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/texlive/"], None},
  ButtonNote->"https://tug.org/texlive/"],
 " \[LongDash] on macOS, MacTeX, ",
 ButtonBox["https://tug.org/mactex/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/mactex/"], None},
  ButtonNote->"https://tug.org/mactex/"]
}], "Reference",
 CellDingbat->Cell[
   TextData["[texlive]"]],
 ParagraphIndent->0,
 CellTags->"texlive",ExpressionUUID->"73603389-9576-4a09-84a0-3883cc1835a2"],

Cell[TextData[{
 "Latin Modern, ",
 ButtonBox["https://ctan.org/pkg/lm",
  BaseStyle->"Hyperlink",
