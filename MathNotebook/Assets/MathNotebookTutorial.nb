(* Beginning of Notebook Content *)
Notebook[{
Cell["Writing Mathematics in Notebooks", "Title",ExpressionUUID->"a9984114-75a3-4e86-95a9-a770ea95f52b"],

Cell["MathNotebook Tutorial", "Author",ExpressionUUID->"44de18bd-905d-44f0-a1f9-b2e41412feb8"],

Cell["\<\
How to write a mathematics paper in a Wolfram notebook: journal stylesheets, \
live referencing, and conversion between LaTeX source and native typeset \
math. Whether the mathematics is written as LaTeX or as built-in typeset math \
is your choice throughout \[LongDash] the palette only moves a selection from \
one to the other.\
\>", "Abstract",ExpressionUUID->"7acf437e-82ea-42f7-bfee-a244a62ea1af"],

Cell["Getting Started", "Section",ExpressionUUID->"14217eef-29ad-4ef0-b54c-a42053db5785"],

Cell[TextData[{
 "After installing the paclet, restart the front end so that ",
 StyleBox["Palettes \[RightArrow] MathNotebook",
  FontSlant->"Italic"],
 " and the stylesheet menu appear."
}], "Item",ExpressionUUID->"010a5f03-70fc-4ffc-8e3c-702803e649d5"],

Cell[TextData[{
 "Give a notebook a journal style with ",
 StyleBox["Format \[RightArrow] Stylesheet \[RightArrow] MathNotebook",
  FontSlant->"Italic"],
 ", or the palette's ",
 StyleBox["Apply stylesheet",
  FontSlant->"Italic"],
 " menu; ",
 StyleBox["Default",
  FontSlant->"Italic"],
 " in that menu takes it back."
}], "Item",ExpressionUUID->"ddf22f3c-9265-4a0a-8514-ca0fd090bd77"],

Cell[TextData[{
 "Style the opening cells ",
 StyleBox["Title",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Author",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Abstract",
  FontSlant->"Italic"],
 ", then write in ",
 StyleBox["Section",
  FontSlant->"Italic"],
 " and ",
 StyleBox["Text",
  FontSlant->"Italic"],
 " cells."
}], "Item",ExpressionUUID->"8e9a99a4-238e-416a-a60a-45de9f996c5a"],

Cell["\<\
Every palette button acts on the notebook you were last editing, and on its \
current selection.\
\>", "Item",ExpressionUUID->"ad60efe2-57f1-4a8a-9bbc-1eadfa83b767"],

Cell["\<\
The journal stylesheets are light-only; applying one from the palette also \
sets the notebook to light mode, so printed and exported output matches the \
screen.\
\>", "Item",ExpressionUUID->"1b804658-ad16-4571-beff-3adade8d1ea5"],

Cell["Referencing", "Section",ExpressionUUID->"f3ff4a5d-4574-4546-8ac1-97fbcc5564d7"],

Cell[TextData[{
 "Select a numbered cell \[LongDash] an equation, a theorem, a section, a \
numbered item \[LongDash] and press ",
 StyleBox["Copy reference",
  FontSlant->"Italic"],
 ", then paste into your text."
}], "Item",ExpressionUUID->"9f33583b-3ff3-49f2-b18c-26d4cfc9bb00"],

Cell["\<\
The pasted reference is a live button showing the current number, so \
reordering cells renumbers every reference to them.\
\>", "Item",ExpressionUUID->"332f28a3-0a2a-49b7-8fbc-a89cf629c03c"],

Cell[TextData[{
 "Clicking a reference jumps to its target; ",
 StyleBox["\[UpArrow] Go back",
  FontSlant->"Italic"],
 " returns to where you clicked from."
}], "Item",ExpressionUUID->"3fd3b2f9-4a04-4ef3-a649-c2777fe9a01f"],

Cell[TextData[{
 StyleBox["Tag cell",
  FontSlant->"Italic"],
 " names a cell, and ",
 StyleBox["Insert citation",
  FontSlant->"Italic"],
 " inserts a red bracketed link to that name \[LongDash] the two together \
give a bibliography: style each entry ",
 StyleBox["Reference",
  FontSlant->"Italic"],
 ", tag it, cite it."
}], "Item",ExpressionUUID->"0573fcec-3b44-4e49-9793-87e47b6299dd"],

Cell[TextData[{
 "Existing tags are listed under ",
 StyleBox["Cell \[RightArrow] Cell Tags",
  FontSlant->"Italic"],
 "."
}], "Item",ExpressionUUID->"4347fe88-ab32-44fb-b458-cbda6e90bd77"],

Cell["\<\
The theorem below and the equation after it are practice targets: select \
either one and copy a reference to it.\
\>", "Item",ExpressionUUID->"1abee08f-86bf-4c2b-b3f3-7ea1641dc6d9"],

Cell["The exponential map is surjective onto the unit circle.", "Theorem",ExpressionUUID->"a7fa71ef-ca9c-446a-b97c-75becd0368b9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["e", 
    RowBox[{"\[ImaginaryI]", "\[Pi]"}]], "+", "1", "=", "0"}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"72f4aa94-054f-\
496d-9366-d11e8ac1b26a"],

Cell["Stylesheets", "Section",ExpressionUUID->"019808b6-1136-43e1-9b67-26dcaaaa77fa"],

Cell[TextData[{
 "Four templates: ",
 StyleBox["AMSArticle",
  FontSlant->"Italic"],
 " (amsart, Palatino), ",
 StyleBox["ArXivArticle",
  FontSlant->"Italic"],
 " (article, Latin Modern), ",
 StyleBox["SpringerJournal",
  FontSlant->"Italic"],
 " and ",
 StyleBox["RevTeXAPS",
  FontSlant->"Italic"],
 " (Times)."
}], "Item",ExpressionUUID->"fbdb4a8c-343c-4391-8654-35e41e926b88"],

Cell["\<\
All four define the same style names, so switching between them is instant \
and changes nothing but the typography.\
\>", "Item",ExpressionUUID->"07304783-1a52-47e0-a2aa-dc2e76442509"],

Cell["\<\
Theorem, Lemma, Proposition, Corollary, Conjecture, Claim, Definition, \
Example, Construction, Remark, Question, and Observation share a single \
counter that resets at each section, exactly as in LaTeX; numbered equations \
count continuously through the document.\
\>", "Item",ExpressionUUID->"c64d4ef1-2230-4ce5-9b46-9ab969c741fb"],

Cell[TextData[{
 "Insert environments from the palette's ",
 StyleBox["Insert environment",
  FontSlant->"Italic"],
 " menu, or with the ",
 StyleBox["Proof",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Equation",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["Equation (n)",
  FontSlant->"Italic"],
 " buttons."
}], "Item",ExpressionUUID->"51f09595-a47c-4b3c-8261-0cc37b438145"],

Cell[TextData[{
 "Latin Modern and TeX Gyre are LaTeX fonts, not system fonts: press ",
 StyleBox["Install LaTeX fonts",
  FontSlant->"Italic"],
 " once to copy them out of a local TeX distribution (",
 ButtonBox["tug.org/texlive",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/texlive/"], None},
  ButtonNote->"https://tug.org/texlive/"],
 ") into your user font directory, then restart the front end. They are \
installed for the whole machine, not inside Mathematica, so any application \
can use them."
}], "Item",ExpressionUUID->"575d05b1-baff-4b09-bdb8-c215cccf69fa"],

Cell["Reading and Writing Comfortably", "Section",ExpressionUUID->"6606f3f3-ff7c-485c-9f83-ebdc53f06865"],

Cell["\<\
Each palette group folds: click its opener or its name to collapse it, so \
only the buttons you are using take up room. The palette remembers which \
groups are open across front end restarts.\
\>", "Item",ExpressionUUID->"6a6ba97a-6c27-4460-9c5b-415f913cc3f1"],

Cell[TextData[{
 "The ",
 StyleBox["Document view",
  FontSlant->"Italic"],
 " group holds three sliders and a reset. Like every other palette control \
they act on the notebook you were last editing, so leave the palette open \
beside your paper and drag while you read it."
}], "Item",ExpressionUUID->"1b21a995-620f-4651-892e-95fb4763d970"],

Cell[TextData[{
 StyleBox["Text size",
  FontSlant->"Italic"],
 " sets the size of ",
 StyleBox["Text",
  FontSlant->"Italic"],
 " and scales the title, the headings, and the abstract with it, so the \
document keeps its proportions instead of one style growing alone."
}], "Item",ExpressionUUID->"6988613d-6566-4b9c-9d19-03ecd3d1e549"],

Cell[TextData[{
 StyleBox["Math size",
  FontSlant->"Italic"],
 " does the same for displayed equations and their numbers, independently of \
the prose \[LongDash] the usual reason to reach for it is an equation left \
too small to read beside text you have just enlarged."
}], "Item",ExpressionUUID->"e59ee201-ea5f-40f4-ba4e-02cb9f921411"],

Cell[TextData[{
 StyleBox["Column width",
  FontSlant->"Italic"],
 " is the fraction of the page the content occupies, centered in it. ",
 StyleBox["0.9",
  FontSlant->"Italic"],
 " is the measure the stylesheets already set; narrowing it gives the short \
line a printed page has, which is what makes a paper readable on a wide \
screen. Section numbers and the theorem and abstract dingbats keep hanging in \
the margin at every width."
}], "Item",ExpressionUUID->"3f5e128c-98a0-4eaa-9689-4264a546c7bb"],

Cell[TextData[{
 "All three set real font sizes and margins, so they reach the exported PDF. ",
 StyleBox["Format \[RightArrow] Magnification",
  FontSlant->"Italic"],
 " is a different thing entirely \[LongDash] it zooms the screen and never \
changes print."
}], "Item",ExpressionUUID->"bf672668-f5e3-435e-8c24-878a67707b2e"],

Cell["\<\
The settings are stored in the notebook itself, so they survive saving and \
reopening and travel with the file to a coauthor.\
\>", "Item",ExpressionUUID->"455251b5-a666-47ac-b3a7-d3277325a79d"],

Cell[TextData[{
 StyleBox["Reset view",
  FontSlant->"Italic"],
 " returns the notebook to its stylesheet defaults and leaves no trace of the \
overrides; applying a stylesheet clears them too, since the new sheet \
replaces them."
}], "Item",ExpressionUUID->"130e2d5d-1215-47ab-80bf-ea64e8966e22"],

Cell[TextData[{
 "MaTeX cells are images and cannot inherit a style, so ",
 StyleBox["Math size",
  FontSlant->"Italic"],
 " re-renders each of them through LaTeX at the new size, from the TeX the \
cell stores."
}], "Item",ExpressionUUID->"63ab3041-1c21-4f90-9ce4-9716b0cea1d5"],

Cell[TextData[{
 "The same from code, on any notebook: ",
 StyleBox["SetDocumentFontSize[nb, 16]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["SetMathFontSize[nb, 16]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["SetContentWidth[nb, 0.6]",
  FontSlant->"Italic"],
 " \[LongDash] each takes ",
 StyleBox["Automatic",
  FontSlant->"Italic"],
 " to drop its own override \[LongDash] and ",
 StyleBox["ResetDocumentView[nb]",
  FontSlant->"Italic"],
 " to drop all of them. They work on a notebook still using ",
 StyleBox["Default",
  FontSlant->"Italic"],
 " too."
}], "Item",ExpressionUUID->"0d024e43-91a2-4149-acb7-249037ed9987"],

Cell["Math Input Shortcuts", "Section",ExpressionUUID->"e57cfe1f-4ace-4de0-bc3e-94d9f2e07279"],

Cell[TextData[{
 StyleBox["Ctrl+9",
  FontWeight->"Bold"],
 " inline math in text, ",
 StyleBox["Ctrl+0",
  FontWeight->"Bold"],
 " exits."
}], "Item",ExpressionUUID->"210e022a-f569-418d-bbae-48723e19b0bf"],

Cell[TextData[{
 StyleBox["Ctrl+/",
  FontWeight->"Bold"],
 " fraction, ",
 StyleBox["Ctrl+2",
  FontWeight->"Bold"],
 " square root."
}], "Item",ExpressionUUID->"8cf34796-a7e8-4621-993d-eb76c91792fe"],

Cell[TextData[{
 StyleBox["Ctrl+^",
  FontWeight->"Bold"],
 " superscript, ",
 StyleBox["Ctrl+_",
  FontWeight->"Bold"],
 " subscript, ",
 StyleBox["Ctrl+%",
  FontWeight->"Bold"],
 " switches between them."
}], "Item",ExpressionUUID->"dea1d970-3682-4c24-b6d1-43a1d9479a6c"],

Cell[TextData[{
 StyleBox["esc",
  FontWeight->"Bold"],
 " ",
 StyleBox["name",
  FontSlant->"Italic"],
 " ",
 StyleBox["esc",
  FontWeight->"Bold"],
 " enters symbols: ",
 StyleBox["a",
  FontSlant->"Italic"],
 " \[RightArrow] \[Alpha], ",
 StyleBox["el",
  FontSlant->"Italic"],
 " \[RightArrow] \[Element], ",
 StyleBox["->",
  FontSlant->"Italic"],
 " \[RightArrow] \[Rule]."
}], "Item",ExpressionUUID->"3552626e-6421-4180-a816-e96befc0c7d0"],

Cell[TextData[{
 StyleBox["Cmd+Shift+E",
  FontWeight->"Bold"],
 " shows the cell expression (",
 StyleBox["Ctrl+Shift+E",
  FontWeight->"Bold"],
 " on Windows)."
}], "Item",ExpressionUUID->"fc291203-1775-40ee-aae8-ab5d49754e77"],

Cell["Working with Cells", "Section",ExpressionUUID->"c6db296d-98c3-49d7-882d-8a8ef52f351b"],

Cell[TextData[{
 "Click a cell bracket to select the cell; drag across brackets to select \
several; ",
 StyleBox["Delete",
  FontWeight->"Bold"],
 " removes them."
}], "Item",ExpressionUUID->"a4b5c689-5f26-4a74-86dc-956a77a85e3f"],

Cell[TextData[{
 StyleBox["Ctrl+.",
  FontWeight->"Bold"],
 " extends the selection outward; repeat to reach the whole cell."
}], "Item",ExpressionUUID->"9d4d9e43-6827-4ddc-9d36-0c1bb5a2b97a"],

Cell[TextData[{
 StyleBox["Cmd+1",
  FontWeight->"Bold"],
 "/",
 StyleBox["4",
  FontWeight->"Bold"],
 "/",
 StyleBox["5",
  FontWeight->"Bold"],
 "/",
 StyleBox["7",
  FontWeight->"Bold"],
 "/",
 StyleBox["9",
  FontWeight->"Bold"],
 " restyle a cell: Title, Section, Subsection, Text, Input."
}], "Item",ExpressionUUID->"f52607b6-7377-4e83-a517-d5ac167fc420"],

Cell[TextData[{
 StyleBox["Cmd+Shift+D",
  FontWeight->"Bold"],
 " divides a cell at the cursor; ",
 StyleBox["Cmd+Shift+M",
  FontWeight->"Bold"],
 " merges selected cells."
}], "Item",ExpressionUUID->"4b7711d5-8bf9-40aa-b411-9d6e2574ae93"],

Cell[TextData[{
 StyleBox["Ctrl+G",
  FontWeight->"Bold"],
 " groups selected cells; ",
 StyleBox["Ctrl+Shift+G",
  FontWeight->"Bold"],
 " ungroups."
}], "Item",ExpressionUUID->"b6bbda7d-5c7e-4c55-8f10-10fc5816ff9d"],

Cell[TextData[{
 "Double-click a group bracket to close or open the group; ",
 StyleBox["Cmd+Shift+{",
  FontWeight->"Bold"],
 " and ",
 StyleBox["Cmd+Shift+}",
  FontWeight->"Bold"],
 " open and close all subgroups."
}], "Item",ExpressionUUID->"3daf0f92-92f5-4b71-9f73-6b5365a594ec"],

Cell["\<\
Double-click a closed group's remaining bracket to reopen it; use Cell \
\[RightArrow] Delete All Output before sharing a notebook.\
\>", "Item",ExpressionUUID->"5769f120-07e1-43e9-8c7d-6ad4efbc0772"],

Cell["LaTeX Conversion", "Section",ExpressionUUID->"1a44d5ce-9740-4c1a-adfa-1d56eb107b3c"],

Cell[TextData[{
 "Select the cells to convert, then press ",
 StyleBox["TeX \[Rule] math",
  FontSlant->"Italic"],
 " or ",
 StyleBox["Math \[Rule] TeX",
  FontSlant->"Italic"],
 ". With nothing selected the whole notebook is converted."
}], "Item",ExpressionUUID->"2befc7b9-8fa1-405d-8894-4b0e858d2abf"],

Cell[TextData[{
 StyleBox["TeX \[Rule] math",
  FontSlant->"Italic"],
 " parses inline ",
 StyleBox["$\[Ellipsis]$",
  FontSlant->"Italic"],
 " and ",
 StyleBox["\\(\[Ellipsis]\\)",
  FontSlant->"Italic"],
 ", and displayed ",
 StyleBox["$$\[Ellipsis]$$",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\\[\[Ellipsis]\\]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["equation",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["align",
  FontSlant->"Italic"],
 "; the starred forms stay unnumbered, the unstarred ones become numbered \
equations."
}], "Item",ExpressionUUID->"280f456b-847d-4b9a-b4e3-d53cc2aca435"],

Cell[TextData[{
 "An ",
 StyleBox["align",
  FontSlant->"Italic"],
 " environment becomes a grid aligned on its ",
 StyleBox["&",
  FontSlant->"Italic"],
 ", so it stays editable as one equation cell."
}], "Item",ExpressionUUID->"c83fc93c-15ca-48a3-a668-9bc48fb71aae"],

Cell[TextData[{
 "Each converted cell keeps its original TeX, so ",
 StyleBox["Math \[Rule] TeX",
  FontSlant->"Italic"],
 " gives back what you typed rather than a re-serialization of the boxes. \
Anything the parser cannot read is left untouched."
}], "Item",ExpressionUUID->"31eb35f1-7404-456b-ac35-e38ed7e744e0"],

Cell[TextData[{
 "Input, Code, and Output cells are skipped, so ",
 StyleBox["$",
  FontSlant->"Italic"],
 " in code is safe. To bring in a LaTeX paper, paste it as Text cells and \
convert."
}], "Item",ExpressionUUID->"70f6d732-f260-4720-ab18-349275184d96"],

Cell["MaTeX", "Section",ExpressionUUID->"4272e9a5-e78a-436b-a1e3-932b8acba809"],

Cell[TextData[{
 "MaTeX (",
 ButtonBox["github.com/szhorvat/MaTeX",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/szhorvat/MaTeX"], None},
  ButtonNote->"https://github.com/szhorvat/MaTeX"],
 ") is optional, and needs a TeX distribution and Ghostscript. It is used \
only by the MaTeX buttons; referencing, stylesheets, and LaTeX conversion do \
not."
}], "Item",ExpressionUUID->"43951284-1fea-404a-b0bd-125d0bc18d94"],

Cell[TextData[{
 "Use it when an equation has to come out of real LaTeX \[LongDash] macros, \
",
 StyleBox["tikz-cd",
  FontSlant->"Italic"],
 " diagrams, exact journal metrics."
}], "Item",ExpressionUUID->"634fd6fd-5883-4e9f-9386-a96b86d58568"],

Cell[TextData[{
 StyleBox["Install MaTeX",
  FontSlant->"Italic"],
 " installs the paclet and points it at the local ",
 StyleBox["pdflatex",
  FontSlant->"Italic"],
 " and ",
 StyleBox["gs",
  FontSlant->"Italic"],
 "."
}], "Item",ExpressionUUID->"e2d484b0-886a-494f-8c6b-526cf24103c5"],

Cell[TextData[{
 StyleBox["Math \[Rule] MaTeX",
  FontSlant->"Italic"],
 " renders the selected display equations through LaTeX; ",
 StyleBox["MaTeX \[Rule] math",
  FontSlant->"Italic"],
 " restores editable typeset math from the TeX stored in each cell."
}], "Item",ExpressionUUID->"cb386158-4d3d-40bb-b2d5-0be4af6520a6"],

Cell[TextData[{
 StyleBox["MaTeX preferences",
  FontSlant->"Italic"],
 " opens your ",
 StyleBox["init.m",
  FontSlant->"Italic"],
 " in the front end \[LongDash] deliberately not through the system handler \
for ",
 StyleBox[".m",
  FontSlant->"Italic"],
 " files. Set the preamble, the magnification, and ",
 StyleBox["$useMaTeXQ = True",
  FontSlant->"Italic"],
 " to route TeX typed into a notebook through LaTeX instead of the built-in \
parser."
}], "Item",ExpressionUUID->"6ec692c7-c7c3-45bb-b78a-4f50b6aa4cba"],

Cell["\<\
MaTeX cells are images: convert them back before editing, and keep rendering \
for last.\
\>", "Item",ExpressionUUID->"6259dde1-245d-4224-b0da-a5a803c5d2ba"],

Cell["Best Practices", "Section",ExpressionUUID->"f758bb03-214d-400a-8e98-129657ec4567"],

Cell["\<\
One environment per cell, inserted from the palette, keeps the styles and \
counters consistent.\
\>", "Item",ExpressionUUID->"4e5e77d2-bd2c-43cd-a286-0703e1d0f3e8"],

Cell["\<\
Tag cells as you write them; tagging a theorem after fifty pages means \
finding it again.\
\>", "Item",ExpressionUUID->"3781e4cb-c540-4131-ad8d-0ed94755939f"],

Cell["\<\
Do not strip cell tagging rules: they hold the TeX source that makes the \
round trip lossless.\
\>", "Item",ExpressionUUID->"b69a7045-d815-41d1-ac61-8c9871b2a344"],

Cell["\<\
Convert to LaTeX at submission time, not continuously \[LongDash] the \
notebook is the source.\
\>", "Item",ExpressionUUID->"82d0320f-9ddb-4aa2-9988-84003c4845a0"],

Cell[TextData[{
 "Before sharing: ",
 StyleBox["Cell \[RightArrow] Delete All Output",
  FontSlant->"Italic"],
 ", and convert MaTeX cells back to math so a coauthor can edit them."
}], "Item",ExpressionUUID->"3a90c4f3-e400-4fdd-bba4-f74ba0e39ccb"],

Cell["Credits", "Section",ExpressionUUID->"42ad7c91-082b-4ec4-9b7b-14030d93da1f"],

Cell[TextData[{
 "The referencing scheme and the MaTeX integration are originally due to Nik \
Murzin, ",
 ButtonBox["github.com/sw1sh",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/sw1sh"], None},
  ButtonNote->"https://github.com/sw1sh"],
 "; this paclet packages and extends that work."
}], "Text",ExpressionUUID->"6fa003b2-d3eb-4054-9856-0361c75fa4c9"],

Cell[TextData[{
 "Nik Murzin, ",
 ButtonBox["https://github.com/sw1sh",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/sw1sh"], None},
  ButtonNote->"https://github.com/sw1sh"]
}], "Reference",ExpressionUUID->"182e8688-c351-48a0-9543-5e1581a5a0f9"],

Cell[TextData[{
 "Szabolcs Horvat, MaTeX: LaTeX labels in Mathematica, ",
 ButtonBox["https://github.com/szhorvat/MaTeX",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/szhorvat/MaTeX"], None},
  ButtonNote->"https://github.com/szhorvat/MaTeX"]
}], "Reference",ExpressionUUID->"a86bf2f4-64a8-45f9-bd80-7dc6bcc50ffc"],

Cell[TextData[{
 "TeX Live, ",
 ButtonBox["https://tug.org/texlive/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/texlive/"], None},
  ButtonNote->"https://tug.org/texlive/"],
 " \[LongDash] on macOS, MacTeX, ",
 ButtonBox["https://tug.org/mactex/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/mactex/"], None},
  ButtonNote->"https://tug.org/mactex/"]
}], "Reference",ExpressionUUID->"542291db-2b68-42c6-8d6b-4d9973b67dc2"],

Cell[TextData[{
 "Latin Modern, ",
 ButtonBox["https://ctan.org/pkg/lm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://ctan.org/pkg/lm"], None},
  ButtonNote->"https://ctan.org/pkg/lm"],
 " and TeX Gyre, ",
 ButtonBox["https://ctan.org/pkg/tex-gyre",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://ctan.org/pkg/tex-gyre"], None},
  ButtonNote->"https://ctan.org/pkg/tex-gyre"]
}], "Reference",ExpressionUUID->"da6d61ad-f698-44d2-bc64-cd6285a3ca59"]
},
