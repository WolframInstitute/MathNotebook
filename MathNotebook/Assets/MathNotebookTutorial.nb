Notebook[{
Cell["Writing Mathematics in Notebooks", "Title",ExpressionUUID->"d0ffb6c2-e29c-4a3f-96f6-d5bec7f189a8"],

Cell["MathNotebook Tutorial", "Author",ExpressionUUID->"2087caa5-3598-4ac7-a88f-400a140365f3"],

Cell["\<\
How to write a mathematics paper in a Wolfram notebook: referencing, journal \
stylesheets, LaTeX conversion, and MaTeX rendering.\
\>", "Abstract",ExpressionUUID->"fc54f7ea-aa43-4daa-b816-ea8a0e8013ef"],

