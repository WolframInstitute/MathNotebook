 CellTags->"matex",ExpressionUUID->"9f1af56b-0fc4-4dac-abb8-7f13d7cdf543"],

Cell[TextData[{
 "TeX Live, ",
 ButtonBox["https://tug.org/texlive/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/texlive/"], None},
  ButtonNote->"https://tug.org/texlive/"],
 " \[LongDash] on macOS, MacTeX, ",
 ButtonBox["https://tug.org/mactex/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/mactex/"], None},
  ButtonNote->"https://tug.org/mactex/"]
}], "Reference",
 CellDingbat->Cell[
   TextData["[texlive]"]],
 ParagraphIndent->0,
 CellTags->"texlive",ExpressionUUID->"5d8f32c1-7e04-49f2-86a9-f6daffd383c5"],

Cell[TextData[{
 "Latin Modern, ",
 ButtonBox["https://ctan.org/pkg/lm",
  BaseStyle->"Hyperlink",
