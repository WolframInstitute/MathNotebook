(* Beginning of Notebook Content *)
Notebook[{
Cell["Writing Mathematics in Notebooks", "Title",ExpressionUUID->"d03fbba9-4056-4e22-95b2-1f7cecdaa8fa"],

Cell["MathNotebook Tutorial", "Author",ExpressionUUID->"9fc029ae-3369-482f-a1be-0a9813e239da"],

Cell["\<\
How to write a mathematics paper in a Wolfram notebook: journal stylesheets, \
live referencing, and conversion between LaTeX source and native typeset \
math. Whether the mathematics is written as LaTeX or as built-in typeset math \
is your choice throughout \[LongDash] the palette only moves a selection from \
one to the other.\
\>", "Abstract",ExpressionUUID->"dd8d0ecc-384e-4284-8f8a-a774dcba898a"],

Cell["Getting Started", "Section",ExpressionUUID->"60e9877c-80c5-490e-87b5-e82145c39a1b"],

Cell[TextData[{
 "After installing the paclet, restart the front end so that ",
 StyleBox["Palettes \[RightArrow] MathNotebook",
  FontSlant->"Italic"],
 " and the stylesheet menu appear."
}], "Item",ExpressionUUID->"a9d8da9a-23d1-4488-81f6-87d10d88e58c"],

Cell[TextData[{
 "Give a notebook a journal style with ",
 StyleBox["Format \[RightArrow] Stylesheet \[RightArrow] MathNotebook",
  FontSlant->"Italic"],
 ", or the palette's ",
 StyleBox["Apply stylesheet",
  FontSlant->"Italic"],
 " menu; ",
 StyleBox["Default",
  FontSlant->"Italic"],
 " in that menu takes it back."
}], "Item",ExpressionUUID->"f3757828-5b78-42fb-8f03-74fe632d4ee1"],

Cell[TextData[{
 "Style the opening cells ",
 StyleBox["Title",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Author",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Abstract",
  FontSlant->"Italic"],
 ", then write in ",
 StyleBox["Section",
  FontSlant->"Italic"],
 " and ",
 StyleBox["Text",
  FontSlant->"Italic"],
 " cells."
}], "Item",ExpressionUUID->"bd232cad-275b-4be0-b87a-f339590d0129"],

Cell["\<\
Every palette button acts on the notebook you were last editing, and on its \
current selection.\
\>", "Item",ExpressionUUID->"fd854c96-dbcc-449c-b46b-f67e7a118246"],

Cell["\<\
The journal stylesheets are light-only; applying one from the palette also \
sets the notebook to light mode, so printed and exported output matches the \
screen.\
\>", "Item",ExpressionUUID->"817c9556-114f-4487-b098-e03f3ec31b8b"],

Cell[TextData[{
 StyleBox["Update from cloud",
  FontSlant->"Italic"],
 ", in the palette's ",
 StyleBox["Setup",
  FontSlant->"Italic"],
 " group, asks the Wolfram Cloud which version is published and installs it \
only when it is newer than the one you have \[LongDash] so checking costs a \
line of text, not a download. It then rebuilds the front end menus and \
reopens the palette, which makes the new palette, stylesheets and tutorial \
live immediately."
}], "Item",ExpressionUUID->"3801f46d-04d9-463a-bdf7-88fe34844243"],

Cell[TextData[{
 "It always says which of three things happened: updated, with the old and \
new version numbers; already current; or the cloud could not be reached. \
Kernel code from the new version loads after ",
 StyleBox["Evaluation \[RightArrow] Quit Kernel",
  FontSlant->"Italic"],
 " \[LongDash] the button will not quit the kernel out from under your \
session."
}], "Item",ExpressionUUID->"b40bf3a6-d368-4039-89f1-628ca2b478b5"],

Cell[TextData[{
 "A copy loaded from a development directory shadows anything installed from \
the cloud, so the button reports that and downloads nothing. The same check \
from code: ",
 StyleBox["UpdateMathNotebook[]",
  FontSlant->"Italic"],
 "."
}], "Item",ExpressionUUID->"98beb23a-ceee-4339-8888-c461f208f344"],

Cell["Referencing", "Section",ExpressionUUID->"c39bec64-94ea-408e-9f6f-749d850b7917"],

Cell[TextData[{
 "Select a numbered cell \[LongDash] an equation, a theorem, a section, a \
numbered item \[LongDash] and press ",
 StyleBox["Copy reference",
  FontSlant->"Italic"],
 ", then paste into your text."
}], "Item",ExpressionUUID->"b2ef150f-32a5-43ad-b9ae-2f4629f28eed"],

Cell["\<\
The pasted reference is a live button showing the current number, so \
reordering cells renumbers every reference to them.\
\>", "Item",ExpressionUUID->"7632e0f2-0b4f-4c73-89be-adaac074f01c"],

Cell[TextData[{
 "Clicking a reference jumps to its target; ",
 StyleBox["\[UpArrow] Go back",
  FontSlant->"Italic"],
 " returns to where you clicked from."
}], "Item",ExpressionUUID->"32b0d73e-5607-405e-b37f-9cc5a0674bd5"],

Cell[TextData[{
 StyleBox["Tag cell",
  FontSlant->"Italic"],
 " names a cell, and ",
 StyleBox["Insert citation",
  FontSlant->"Italic"],
 " inserts a red bracketed link to that name \[LongDash] the two together \
give a bibliography: style each entry ",
 StyleBox["Reference",
  FontSlant->"Italic"],
 ", tag it, cite it."
}], "Item",ExpressionUUID->"2d46bd7b-3745-40fb-84f9-3d38f21e58a2"],

Cell[TextData[{
 "Existing tags are listed under ",
 StyleBox["Cell \[RightArrow] Cell Tags",
  FontSlant->"Italic"],
 "."
}], "Item",ExpressionUUID->"1f852926-11a5-409b-b7bc-d430ecabc191"],

Cell["\<\
The theorem below and the equation after it are practice targets: select \
either one and copy a reference to it.\
\>", "Item",ExpressionUUID->"d55119cd-248b-40f1-9b1a-45c8543c19c9"],

Cell["The exponential map is surjective onto the unit circle.", "Theorem",ExpressionUUID->"cee5ee6a-406b-492c-8eac-6a52f755934b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["e", 
    RowBox[{"\[ImaginaryI]", "\[Pi]"}]], "+", "1", "=", "0"}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"51b3514c-8df8-\
46cf-b078-d891a459ad2c"],

Cell["Stylesheets", "Section",ExpressionUUID->"e49f6385-dd0e-4528-bdfc-474f49a8e389"],

Cell[TextData[{
 "Four templates: ",
 StyleBox["AMSArticle",
  FontSlant->"Italic"],
 " (amsart, Palatino), ",
 StyleBox["ArXivArticle",
  FontSlant->"Italic"],
 " (article, Latin Modern), ",
 StyleBox["SpringerJournal",
  FontSlant->"Italic"],
 " and ",
 StyleBox["RevTeXAPS",
  FontSlant->"Italic"],
 " (Times)."
}], "Item",ExpressionUUID->"b1a7053c-50e0-4626-b9a9-ebd3ce358108"],

Cell["\<\
All four define the same style names, so switching between them is instant \
and changes nothing but the typography.\
\>", "Item",ExpressionUUID->"d11a07f2-6cd8-4fdf-bd0d-9baccc7002d4"],

Cell["\<\
Theorem, Lemma, Proposition, Corollary, Conjecture, Claim, Definition, \
Example, Construction, Remark, Question, and Observation share a single \
counter that resets at each section, exactly as in LaTeX; numbered equations \
count continuously through the document.\
\>", "Item",ExpressionUUID->"25a07de5-cac7-42db-93be-f8ae1d16a4ed"],

Cell[TextData[{
 "Insert environments from the palette's ",
 StyleBox["Insert environment",
  FontSlant->"Italic"],
 " menu, or with the ",
 StyleBox["Proof",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Equation",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["Equation (n)",
  FontSlant->"Italic"],
 " buttons."
}], "Item",ExpressionUUID->"8a1d79e2-64df-4cea-b8b5-c7a3107748a8"],

Cell[TextData[{
 "Latin Modern and TeX Gyre are LaTeX fonts, not system fonts: press ",
 StyleBox["Install LaTeX fonts",
  FontSlant->"Italic"],
 " once to copy them out of a local TeX distribution (",
 ButtonBox["tug.org/texlive",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/texlive/"], None},
  ButtonNote->"https://tug.org/texlive/"],
 ") into your user font directory, then restart the front end. They are \
installed for the whole machine, not inside Mathematica, so any application \
can use them."
}], "Item",ExpressionUUID->"1678d309-7fba-4263-b86e-c928aef314dd"],

Cell["Reading and Writing Comfortably", "Section",ExpressionUUID->"c1c38b8b-712c-4ea9-8b62-eaebdff039b7"],

Cell["\<\
Each palette group folds: click its opener or its name to collapse it, so \
only the buttons you are using take up room. The palette remembers which \
groups are open across front end restarts.\
\>", "Item",ExpressionUUID->"571f3351-988e-400e-95c4-af2f440f403f"],

Cell[TextData[{
 "The ",
 StyleBox["Document view",
  FontSlant->"Italic"],
 " group holds two sliders and a reset. Like every other palette control they \
act on the notebook you were last editing, so leave the palette open beside \
your paper and drag while you read it."
}], "Item",ExpressionUUID->"10c6b03d-bc3e-4499-a5be-0e4458f127bb"],

Cell[TextData[{
 StyleBox["Text size",
  FontSlant->"Italic"],
 " sets the size of ",
 StyleBox["Text",
  FontSlant->"Italic"],
 " and scales the title, the headings, and the abstract with it, so the \
document keeps its proportions instead of one style growing alone."
}], "Item",ExpressionUUID->"fa253b68-5f58-4da6-b583-fa2cabc9e573"],

Cell[TextData[{
 StyleBox["Math size",
  FontSlant->"Italic"],
 " does the same for displayed equations and their numbers, independently of \
the prose \[LongDash] the usual reason to reach for it is an equation left \
too small to read beside text you have just enlarged."
}], "Item",ExpressionUUID->"2897b4a8-ccaf-44e3-b84c-9c38eba643f5"],

Cell[TextData[{
 "Both set real font sizes, so they reach the exported PDF. ",
 StyleBox["Format \[RightArrow] Magnification",
  FontSlant->"Italic"],
 " is a different thing entirely \[LongDash] it zooms the screen and never \
changes print."
}], "Item",ExpressionUUID->"4a4303b3-e9f4-46d2-9fcb-fa18af538c03"],

Cell["\<\
The settings are stored in the notebook itself, so they survive saving and \
reopening and travel with the file to a coauthor.\
\>", "Item",ExpressionUUID->"e7603e27-e672-4b7c-ae2a-0dd7ef20ea23"],

Cell[TextData[{
 StyleBox["Reset view",
  FontSlant->"Italic"],
 " returns the notebook to its stylesheet defaults and leaves no trace of the \
overrides; applying a stylesheet clears them too, since the new sheet \
replaces them."
}], "Item",ExpressionUUID->"d654b278-ab9c-4583-8e21-a167445c481e"],

Cell[TextData[{
 "MaTeX cells are images and cannot inherit a style, so ",
 StyleBox["Math size",
  FontSlant->"Italic"],
 " re-renders each of them through LaTeX at the new size, from the TeX the \
cell stores."
}], "Item",ExpressionUUID->"a75b91f6-797d-47f1-8c28-2a6c9fa6d679"],

Cell[TextData[{
 "The same from code, on any notebook: ",
 StyleBox["SetDocumentFontSize[nb, 16]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["SetMathFontSize[nb, 16]",
  FontSlant->"Italic"],
 " \[LongDash] each takes ",
 StyleBox["Automatic",
  FontSlant->"Italic"],
 " to drop its own override \[LongDash] and ",
 StyleBox["ResetDocumentView[nb]",
  FontSlant->"Italic"],
 " to drop all of them. They work on a notebook still using ",
 StyleBox["Default",
  FontSlant->"Italic"],
 " too."
}], "Item",ExpressionUUID->"9d480f21-d365-4958-9ec7-aaee7144dfea"],

Cell["Math Input Shortcuts", "Section",ExpressionUUID->"972904fa-79ac-4819-90ff-fb57d5263108"],

Cell[TextData[{
 StyleBox["Ctrl+9",
  FontWeight->"Bold"],
 " inline math in text, ",
 StyleBox["Ctrl+0",
  FontWeight->"Bold"],
 " exits."
}], "Item",ExpressionUUID->"5b51e1f7-24b7-4ad1-a143-370e6596ca72"],

Cell[TextData[{
 StyleBox["Ctrl+/",
  FontWeight->"Bold"],
 " fraction, ",
 StyleBox["Ctrl+2",
  FontWeight->"Bold"],
 " square root."
}], "Item",ExpressionUUID->"d76e5aa5-9ede-4576-b02a-a668c3a83217"],

Cell[TextData[{
 StyleBox["Ctrl+^",
  FontWeight->"Bold"],
 " superscript, ",
 StyleBox["Ctrl+_",
  FontWeight->"Bold"],
 " subscript, ",
 StyleBox["Ctrl+%",
  FontWeight->"Bold"],
 " switches between them."
}], "Item",ExpressionUUID->"c6920e0a-5104-4d1b-b063-da1a8d1748aa"],

Cell[TextData[{
 StyleBox["esc",
  FontWeight->"Bold"],
 " ",
 StyleBox["name",
  FontSlant->"Italic"],
 " ",
 StyleBox["esc",
  FontWeight->"Bold"],
 " enters symbols: ",
 StyleBox["a",
  FontSlant->"Italic"],
 " \[RightArrow] \[Alpha], ",
 StyleBox["el",
  FontSlant->"Italic"],
 " \[RightArrow] \[Element], ",
 StyleBox["->",
  FontSlant->"Italic"],
 " \[RightArrow] \[Rule]."
}], "Item",ExpressionUUID->"17d56f76-1d0a-4c12-b15f-216f4076dcd0"],

Cell[TextData[{
 StyleBox["Cmd+Shift+E",
  FontWeight->"Bold"],
 " shows the cell expression (",
 StyleBox["Ctrl+Shift+E",
  FontWeight->"Bold"],
 " on Windows)."
}], "Item",ExpressionUUID->"61a27843-d60e-48f1-9d9f-439ae285cd98"],

Cell["Working with Cells", "Section",ExpressionUUID->"d7a2eded-5a33-487e-bb6f-b5a9b21f8a06"],

Cell[TextData[{
 "Click a cell bracket to select the cell; drag across brackets to select \
several; ",
 StyleBox["Delete",
  FontWeight->"Bold"],
 " removes them."
}], "Item",ExpressionUUID->"84d083d5-72cd-4896-a0f0-71d5881827ce"],

Cell[TextData[{
 StyleBox["Ctrl+.",
  FontWeight->"Bold"],
 " extends the selection outward; repeat to reach the whole cell."
}], "Item",ExpressionUUID->"2240a17b-4b7c-466d-b1ee-71b044133378"],

Cell[TextData[{
 StyleBox["Cmd+1",
  FontWeight->"Bold"],
 "/",
 StyleBox["4",
  FontWeight->"Bold"],
 "/",
 StyleBox["5",
  FontWeight->"Bold"],
 "/",
 StyleBox["7",
  FontWeight->"Bold"],
 "/",
 StyleBox["9",
  FontWeight->"Bold"],
 " restyle a cell: Title, Section, Subsection, Text, Input."
}], "Item",ExpressionUUID->"57645d6e-0ff5-4b2b-b93e-991d183ff881"],

Cell[TextData[{
 StyleBox["Cmd+Shift+D",
  FontWeight->"Bold"],
 " divides a cell at the cursor; ",
 StyleBox["Cmd+Shift+M",
  FontWeight->"Bold"],
 " merges selected cells."
}], "Item",ExpressionUUID->"8036f651-fc25-439c-92b9-0737fc91e770"],

Cell[TextData[{
 StyleBox["Ctrl+G",
  FontWeight->"Bold"],
 " groups selected cells; ",
 StyleBox["Ctrl+Shift+G",
  FontWeight->"Bold"],
 " ungroups."
}], "Item",ExpressionUUID->"cba5c77b-599e-4d05-b9b5-efec453f9f0e"],

Cell[TextData[{
 "Double-click a group bracket to close or open the group; ",
 StyleBox["Cmd+Shift+{",
  FontWeight->"Bold"],
 " and ",
 StyleBox["Cmd+Shift+}",
  FontWeight->"Bold"],
 " open and close all subgroups."
}], "Item",ExpressionUUID->"e482a34a-427d-48b7-ac60-f566d443d71e"],

Cell["\<\
Double-click a closed group's remaining bracket to reopen it; use Cell \
\[RightArrow] Delete All Output before sharing a notebook.\
\>", "Item",ExpressionUUID->"caae9deb-c971-4704-b73d-78f726cc9c61"],

Cell["LaTeX Conversion", "Section",ExpressionUUID->"94a89f1e-6a2c-4008-8d99-8f4c9dcfef0b"],

Cell[TextData[{
 "Select the cells to convert, then press ",
 StyleBox["TeX \[Rule] math",
  FontSlant->"Italic"],
 " or ",
 StyleBox["Math \[Rule] TeX",
  FontSlant->"Italic"],
 ". With nothing selected the whole notebook is converted."
}], "Item",ExpressionUUID->"7c35640d-86f8-423e-8acb-f82644d4792a"],

Cell[TextData[{
 StyleBox["TeX \[Rule] math",
  FontSlant->"Italic"],
 " parses inline ",
 StyleBox["$\[Ellipsis]$",
  FontSlant->"Italic"],
 " and ",
 StyleBox["\\(\[Ellipsis]\\)",
  FontSlant->"Italic"],
 ", and displayed ",
 StyleBox["$$\[Ellipsis]$$",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\\[\[Ellipsis]\\]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["equation",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["align",
  FontSlant->"Italic"],
 "; the starred forms stay unnumbered, the unstarred ones become numbered \
equations."
}], "Item",ExpressionUUID->"389a2d78-b608-497a-a0fc-19c46837d1ad"],

Cell[TextData[{
 "An ",
 StyleBox["align",
  FontSlant->"Italic"],
 " environment becomes a grid aligned on its ",
 StyleBox["&",
  FontSlant->"Italic"],
 ", so it stays editable as one equation cell."
}], "Item",ExpressionUUID->"2df63e55-4f28-4f16-bdbd-4505171b6662"],

Cell[TextData[{
 "Each converted cell keeps its original TeX, so ",
 StyleBox["Math \[Rule] TeX",
  FontSlant->"Italic"],
 " gives back what you typed rather than a re-serialization of the boxes. \
Anything the parser cannot read is left untouched."
}], "Item",ExpressionUUID->"a76ce5f7-ee28-4c31-a2df-4ad884719681"],

Cell[TextData[{
 "Input, Code, and Output cells are skipped, so ",
 StyleBox["$",
  FontSlant->"Italic"],
 " in code is safe. To bring in a LaTeX paper, paste it as Text cells and \
convert."
}], "Item",ExpressionUUID->"e2b0b92a-30fd-4a30-8485-18c53d981c02"],

Cell["MaTeX", "Section",ExpressionUUID->"dfdc78fd-d72f-477e-a047-9542b0afa83d"],

Cell[TextData[{
 "MaTeX (",
 ButtonBox["github.com/szhorvat/MaTeX",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/szhorvat/MaTeX"], None},
  ButtonNote->"https://github.com/szhorvat/MaTeX"],
 ") is optional, and needs a TeX distribution and Ghostscript. It is used \
only by the MaTeX buttons; referencing, stylesheets, and LaTeX conversion do \
not."
}], "Item",ExpressionUUID->"1f0d16e2-3693-4744-8287-e5cbb751cf69"],

Cell[TextData[{
 "Use it when an equation has to come out of real LaTeX \[LongDash] macros, \
",
 StyleBox["tikz-cd",
  FontSlant->"Italic"],
 " diagrams, exact journal metrics."
}], "Item",ExpressionUUID->"abbf7378-301b-467e-9551-d62feb23b374"],

Cell[TextData[{
 StyleBox["Install MaTeX",
  FontSlant->"Italic"],
 " installs the paclet and points it at the local ",
 StyleBox["pdflatex",
  FontSlant->"Italic"],
 " and ",
 StyleBox["gs",
  FontSlant->"Italic"],
 "."
}], "Item",ExpressionUUID->"35c3dfc8-3162-405c-ba20-2cc358884b9a"],

Cell[TextData[{
 StyleBox["Math \[Rule] MaTeX",
  FontSlant->"Italic"],
 " renders the selected display equations through LaTeX; ",
 StyleBox["MaTeX \[Rule] math",
  FontSlant->"Italic"],
 " restores editable typeset math from the TeX stored in each cell."
}], "Item",ExpressionUUID->"481f1456-1df7-4832-9f61-1ec09be684a4"],

Cell[TextData[{
 StyleBox["MaTeX preferences",
  FontSlant->"Italic"],
 " opens your ",
 StyleBox["init.m",
  FontSlant->"Italic"],
 " in the front end \[LongDash] deliberately not through the system handler \
for ",
 StyleBox[".m",
  FontSlant->"Italic"],
 " files. Set the preamble, the magnification, and ",
 StyleBox["$useMaTeXQ = True",
  FontSlant->"Italic"],
 " to route TeX typed into a notebook through LaTeX instead of the built-in \
parser."
}], "Item",ExpressionUUID->"28f0e051-13d6-4745-ba10-1219700df77b"],

Cell["\<\
MaTeX cells are images: convert them back before editing, and keep rendering \
for last.\
\>", "Item",ExpressionUUID->"9eb9f2cd-6b65-410c-9efb-ae19ac54a263"],

Cell["Best Practices", "Section",ExpressionUUID->"041c8aba-0577-4d34-b470-becf39e295fd"],

Cell["\<\
One environment per cell, inserted from the palette, keeps the styles and \
counters consistent.\
\>", "Item",ExpressionUUID->"76bd647e-1542-484f-ab1a-057dd1ee4bd1"],

Cell["\<\
Tag cells as you write them; tagging a theorem after fifty pages means \
finding it again.\
\>", "Item",ExpressionUUID->"f41e3264-bab9-47e5-9052-9b00191dbd55"],

Cell["\<\
Do not strip cell tagging rules: they hold the TeX source that makes the \
round trip lossless.\
\>", "Item",ExpressionUUID->"bf85abbd-e68a-4039-9bbf-05340094072f"],

Cell["\<\
Convert to LaTeX at submission time, not continuously \[LongDash] the \
notebook is the source.\
\>", "Item",ExpressionUUID->"7b6175ba-9d7f-42da-8731-6fce8b086aab"],

Cell[TextData[{
 "Before sharing: ",
 StyleBox["Cell \[RightArrow] Delete All Output",
  FontSlant->"Italic"],
 ", and convert MaTeX cells back to math so a coauthor can edit them."
}], "Item",ExpressionUUID->"fd1456f3-a8f3-45ba-8aa6-f709b95dce12"],

Cell["Credits", "Section",ExpressionUUID->"d7c8df3a-5491-4c9a-9a57-5e8442b64ae6"],

Cell[TextData[{
 "The referencing scheme and the MaTeX integration are originally due to Nik \
Murzin, ",
 ButtonBox["github.com/sw1sh",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/sw1sh"], None},
  ButtonNote->"https://github.com/sw1sh"],
 "; this paclet packages and extends that work."
}], "Text",ExpressionUUID->"698735b7-189d-4f3c-b06b-f8dfc6983408"],

Cell[TextData[{
 "Nik Murzin, ",
 ButtonBox["https://github.com/sw1sh",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/sw1sh"], None},
  ButtonNote->"https://github.com/sw1sh"]
}], "Reference",ExpressionUUID->"54c209d4-6cbe-4850-bfcc-582644bce169"],

Cell[TextData[{
 "Szabolcs Horvat, MaTeX: LaTeX labels in Mathematica, ",
 ButtonBox["https://github.com/szhorvat/MaTeX",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/szhorvat/MaTeX"], None},
  ButtonNote->"https://github.com/szhorvat/MaTeX"]
}], "Reference",ExpressionUUID->"2e1c77bb-7878-4c88-9197-ea2009107d76"],

Cell[TextData[{
 "TeX Live, ",
 ButtonBox["https://tug.org/texlive/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/texlive/"], None},
  ButtonNote->"https://tug.org/texlive/"],
 " \[LongDash] on macOS, MacTeX, ",
 ButtonBox["https://tug.org/mactex/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/mactex/"], None},
  ButtonNote->"https://tug.org/mactex/"]
}], "Reference",ExpressionUUID->"2f90a81d-d526-4a13-9448-4394cbab00a4"],

Cell[TextData[{
 "Latin Modern, ",
