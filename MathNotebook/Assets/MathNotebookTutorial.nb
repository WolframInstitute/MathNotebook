Notebook[{
Cell["Writing Mathematics in Notebooks", "Title",ExpressionUUID->"f6a0d2d4-88ab-4a07-9ebd-ed704c978a4b"],

Cell["MathNotebook Tutorial", "Author",ExpressionUUID->"362b3c28-25f8-42c5-b186-8878cfc0f1a8"],

Cell["\<\
How to write a mathematics paper in a Wolfram notebook: referencing, journal \
stylesheets, LaTeX conversion, and MaTeX rendering.\
\>", "Abstract",ExpressionUUID->"c8516720-e4e7-4d4c-aa7e-566d7c70b856"],

Cell["Getting Started", "Section",ExpressionUUID->"2ba5da42-bd47-4d20-a4e5-70a9110c654e"],

Cell["Content to be written.", "Text",ExpressionUUID->"45caac2f-af06-4c05-a709-54fb61df779f"],

Cell["Referencing", "Section",ExpressionUUID->"4eec2dc2-ed11-4b2d-9401-3dff95f6748f"],

Cell["Content to be written.", "Text",ExpressionUUID->"89daa902-047e-4dc2-8fe8-02d7a3a46a0c"],

Cell["Stylesheets", "Section",ExpressionUUID->"09b176c2-28a9-491b-87ee-b1495da92148"],

Cell["Content to be written.", "Text",ExpressionUUID->"7e7d44c7-0688-4d0c-a8e0-a7a9040362b5"],

Cell["Math Input Shortcuts", "Section",ExpressionUUID->"fb141e3b-7d78-4f9d-aabf-174e87ccaaf7"],

Cell[TextData[{
 StyleBox["Ctrl+9",
  FontWeight->"Bold"],
 " inline math in text, ",
 StyleBox["Ctrl+0",
  FontWeight->"Bold"],
 " exits."
}], "Item",ExpressionUUID->"800ad4ff-573e-4b5a-baf2-7ef505e32a9c"],

Cell[TextData[{
 StyleBox["Ctrl+/",
  FontWeight->"Bold"],
 " fraction, ",
 StyleBox["Ctrl+2",
  FontWeight->"Bold"],
 " square root."
}], "Item",ExpressionUUID->"ac8edabf-902c-4b1d-bbb6-d077de8bf46b"],

Cell[TextData[{
 StyleBox["Ctrl+^",
  FontWeight->"Bold"],
 " superscript, ",
 StyleBox["Ctrl+_",
  FontWeight->"Bold"],
 " subscript, ",
 StyleBox["Ctrl+%",
  FontWeight->"Bold"],
 " switches between them."
}], "Item",ExpressionUUID->"4280e5ed-895d-4082-ad52-90d9373068f6"],

Cell[TextData[{
 StyleBox["esc",
  FontWeight->"Bold"],
 " ",
 StyleBox["name",
  FontSlant->"Italic"],
 " ",
 StyleBox["esc",
  FontWeight->"Bold"],
 " enters symbols: ",
 StyleBox["a",
  FontSlant->"Italic"],
 " \[RightArrow] \[Alpha], ",
 StyleBox["el",
  FontSlant->"Italic"],
 " \[RightArrow] \[Element], ",
 StyleBox["->",
  FontSlant->"Italic"],
 " \[RightArrow] \[Rule]."
}], "Item",ExpressionUUID->"48aace50-ea28-42cf-9b0e-e5c630f1974c"],

Cell[TextData[{
 StyleBox["Cmd+Shift+E",
  FontWeight->"Bold"],
 " shows the cell expression (",
 StyleBox["Ctrl+Shift+E",
  FontWeight->"Bold"],
 " on Windows)."
}], "Item",ExpressionUUID->"fec724ba-2412-408f-bf65-08a73670ced0"],

Cell["LaTeX Conversion", "Section",ExpressionUUID->"387a5704-bc18-4a32-95c4-1ff5f0595e65"],

Cell["Content to be written.", "Text",ExpressionUUID->"33751809-a58d-491d-866c-a88a82ee5c3b"],

