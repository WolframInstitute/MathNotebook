Cell[14627, 394, 460, 10, 70, "Item",ExpressionUUID->"777ef1a9-7571-4075-8b25-73552cf5d643"],
Cell[15090, 406, 310, 6, 70, "Item",ExpressionUUID->"cbe16d11-46d9-4a00-8e66-37fa6ca2ea7d"],
Cell[15403, 414, 205, 3, 70, "Item",ExpressionUUID->"7fc03c02-8743-420b-b49e-76a042c4bc2d"],
Cell[15611, 419, 771, 13, 70, "Item",ExpressionUUID->"bf3c7aa2-1273-4ced-a0d7-b3cf33d1bf29"],
Cell[16385, 434, 235, 4, 70, "Item",ExpressionUUID->"4a121d58-5845-4a71-aa17-6f935d8bc04a"],
