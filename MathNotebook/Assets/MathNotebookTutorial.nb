(* Beginning of Notebook Content *)
Notebook[{
Cell["Writing Mathematics in Notebooks", "Title",ExpressionUUID->"2cb0dcb9-ec4f-4032-849f-82e3aad12310"],

Cell["MathNotebook Tutorial", "Author",ExpressionUUID->"f2c3f650-6e3a-4067-a81b-28dce9ae6377"],

Cell["\<\
How to write a mathematics paper in a Wolfram notebook: journal stylesheets, \
live referencing, and conversion between LaTeX source and native typeset \
math. Whether the mathematics is written as LaTeX or as built-in typeset math \
is your choice throughout \[LongDash] the palette only moves a selection from \
one to the other.\
\>", "Abstract",ExpressionUUID->"aff6bd7c-c6b9-439d-a237-33bb6a824d00"],

Cell["Getting Started", "Section",ExpressionUUID->"dda12db3-1bda-4b5c-bcf5-f862d8683d0f"],

Cell[TextData[{
 "After installing the paclet, restart the front end so that ",
 StyleBox["Palettes \[RightArrow] MathNotebook",
  FontSlant->"Italic"],
 " and the stylesheet menu appear."
}], "Item",ExpressionUUID->"92cbb733-2eb7-4675-979b-00e60a3b6824"],

Cell[TextData[{
 "Give a notebook a journal style with ",
 StyleBox["Format \[RightArrow] Stylesheet \[RightArrow] MathNotebook",
  FontSlant->"Italic"],
 ", or the palette's ",
 StyleBox["Apply stylesheet",
  FontSlant->"Italic"],
 " menu; ",
 StyleBox["Default",
  FontSlant->"Italic"],
 " in that menu takes it back."
}], "Item",ExpressionUUID->"d0ed3796-ba7f-41b8-9f16-d1953ef961ed"],

Cell[TextData[{
 "Style the opening cells ",
 StyleBox["Title",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Author",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Abstract",
  FontSlant->"Italic"],
 ", then write in ",
 StyleBox["Section",
  FontSlant->"Italic"],
 " and ",
 StyleBox["Text",
  FontSlant->"Italic"],
 " cells."
}], "Item",ExpressionUUID->"fbb301a7-f3e9-4507-85f7-cf88675dc9ac"],

Cell["\<\
Every palette button acts on the notebook you were last editing, and on its \
current selection.\
\>", "Item",ExpressionUUID->"d5b473c9-40c9-4a72-acea-058ac3131068"],

Cell["\<\
The journal stylesheets are light-only; applying one from the palette also \
sets the notebook to light mode, so printed and exported output matches the \
screen.\
\>", "Item",ExpressionUUID->"626298e3-5127-4274-bdd5-fffafe3850ca"],

Cell["Referencing", "Section",ExpressionUUID->"14f0bf7f-9721-4113-95f1-6266fd6815e0"],

Cell[TextData[{
 "Select a numbered cell \[LongDash] an equation, a theorem, a section, a \
numbered item \[LongDash] and press ",
 StyleBox["Copy reference",
  FontSlant->"Italic"],
 ", then paste into your text."
}], "Item",ExpressionUUID->"4e34ce84-0b75-4e52-a0ed-3294b38674a3"],

Cell["\<\
The pasted reference is a live button showing the current number, so \
reordering cells renumbers every reference to them.\
\>", "Item",ExpressionUUID->"982df934-15f4-4ae9-8470-d31f6ce7b77e"],

Cell[TextData[{
 "Clicking a reference jumps to its target; ",
 StyleBox["\[UpArrow] Go back",
  FontSlant->"Italic"],
 " returns to where you clicked from."
}], "Item",ExpressionUUID->"3874157c-de16-4605-8af1-4e585fbc2e4a"],

Cell[TextData[{
 StyleBox["Tag cell",
  FontSlant->"Italic"],
 " names a cell, and ",
 StyleBox["Insert citation",
  FontSlant->"Italic"],
 " inserts a red bracketed link to that name \[LongDash] the two together \
give a bibliography: style each entry ",
 StyleBox["Reference",
  FontSlant->"Italic"],
 ", tag it, cite it."
}], "Item",ExpressionUUID->"9284595d-d6d0-4d96-b7bb-6183565b6db9"],

Cell[TextData[{
 "Existing tags are listed under ",
 StyleBox["Cell \[RightArrow] Cell Tags",
  FontSlant->"Italic"],
 "."
}], "Item",ExpressionUUID->"1c4f67a7-5532-40cb-b23b-3117d8c67e96"],

Cell["\<\
The theorem below and the equation after it are practice targets: select \
either one and copy a reference to it.\
\>", "Item",ExpressionUUID->"d4b20d89-dcb5-4743-b6ea-ec8cee606ba1"],

Cell["The exponential map is surjective onto the unit circle.", "Theorem",ExpressionUUID->"b5d505ea-c511-4557-91a2-bba98be38d93"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["e", 
    RowBox[{"\[ImaginaryI]", "\[Pi]"}]], "+", "1", "=", "0"}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"054e2a22-40be-\
4723-8de8-f52b3f7f5733"],

Cell["Stylesheets", "Section",ExpressionUUID->"c8a59c61-5e8c-40e5-9f3c-b694933b789e"],

Cell[TextData[{
 "Four templates: ",
 StyleBox["AMSArticle",
  FontSlant->"Italic"],
 " (amsart, Palatino), ",
 StyleBox["ArXivArticle",
  FontSlant->"Italic"],
 " (article, Latin Modern), ",
 StyleBox["SpringerJournal",
  FontSlant->"Italic"],
 " and ",
 StyleBox["RevTeXAPS",
  FontSlant->"Italic"],
 " (Times)."
}], "Item",ExpressionUUID->"aea7768c-7167-4820-b140-8296fb0dcab2"],

Cell["\<\
All four define the same style names, so switching between them is instant \
and changes nothing but the typography.\
\>", "Item",ExpressionUUID->"7488be7c-438d-4bc2-92d5-216523852b50"],

Cell["\<\
Theorem, Lemma, Proposition, Corollary, Conjecture, Claim, Definition, \
Example, Construction, Remark, Question, and Observation share a single \
counter that resets at each section, exactly as in LaTeX; numbered equations \
count continuously through the document.\
\>", "Item",ExpressionUUID->"9c4eba28-5193-4ef5-94bd-769ac0ce4b13"],

Cell[TextData[{
 "Insert environments from the palette's ",
 StyleBox["Insert environment",
  FontSlant->"Italic"],
 " menu, or with the ",
 StyleBox["Proof",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Equation",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["Equation (n)",
  FontSlant->"Italic"],
 " buttons."
}], "Item",ExpressionUUID->"77db7eb8-0d10-4fac-8f37-b9f5e42cc7ba"],

Cell[TextData[{
 "Latin Modern and TeX Gyre are LaTeX fonts, not system fonts: press ",
 StyleBox["Install LaTeX fonts",
  FontSlant->"Italic"],
 " once to copy them out of a local TeX distribution (",
 ButtonBox["tug.org/texlive",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/texlive/"], None},
  ButtonNote->"https://tug.org/texlive/"],
 ") into your user font directory, then restart the front end. They are \
installed for the whole machine, not inside Mathematica, so any application \
can use them."
}], "Item",ExpressionUUID->"dd3301c6-c31b-4759-b482-1ace9aeab654"],

Cell["Reading and Writing Comfortably", "Section",ExpressionUUID->"2b7a236e-5f5a-46b2-bd9c-58242feeb48b"],

Cell["\<\
Each palette group folds: click its opener or its name to collapse it, so \
only the buttons you are using take up room. The palette remembers which \
groups are open across front end restarts.\
\>", "Item",ExpressionUUID->"a4c12c79-ed2d-4180-8ce1-3f7aa2947968"],

Cell[TextData[{
 "The ",
 StyleBox["Document view",
  FontSlant->"Italic"],
 " group holds two sliders and a reset. Like every other palette control they \
act on the notebook you were last editing, so leave the palette open beside \
your paper and drag while you read it."
}], "Item",ExpressionUUID->"8290d42e-2146-4e16-9742-34bd99a23d57"],

Cell[TextData[{
 StyleBox["Text size",
  FontSlant->"Italic"],
 " sets the size of ",
 StyleBox["Text",
  FontSlant->"Italic"],
 " and scales the title, the headings, and the abstract with it, so the \
document keeps its proportions instead of one style growing alone."
}], "Item",ExpressionUUID->"e98083f3-901a-49e8-b8e7-65f994d4973d"],

Cell[TextData[{
 StyleBox["Math size",
  FontSlant->"Italic"],
 " does the same for displayed equations and their numbers, independently of \
the prose \[LongDash] the usual reason to reach for it is an equation left \
too small to read beside text you have just enlarged."
}], "Item",ExpressionUUID->"499d4e33-9870-4a96-adb5-93cbfc7c7165"],

Cell[TextData[{
 "Both set real font sizes, so they reach the exported PDF. ",
 StyleBox["Format \[RightArrow] Magnification",
  FontSlant->"Italic"],
 " is a different thing entirely \[LongDash] it zooms the screen and never \
changes print."
}], "Item",ExpressionUUID->"d9d7c2db-3125-4c48-b92c-09cca5e88653"],

Cell["\<\
The settings are stored in the notebook itself, so they survive saving and \
reopening and travel with the file to a coauthor.\
\>", "Item",ExpressionUUID->"766e1fab-a8e0-4d00-948b-846fa597166c"],

Cell[TextData[{
 StyleBox["Reset view",
  FontSlant->"Italic"],
 " returns the notebook to its stylesheet defaults and leaves no trace of the \
overrides; applying a stylesheet clears them too, since the new sheet \
replaces them."
}], "Item",ExpressionUUID->"6f016462-a759-4127-95da-3a655d5ec027"],

Cell[TextData[{
 "MaTeX cells are images and cannot inherit a style, so ",
 StyleBox["Math size",
  FontSlant->"Italic"],
 " re-renders each of them through LaTeX at the new size, from the TeX the \
cell stores."
}], "Item",ExpressionUUID->"8eb24dca-f652-4d75-8d72-f75f2c87fccb"],

Cell[TextData[{
 "The same from code, on any notebook: ",
 StyleBox["SetDocumentFontSize[nb, 16]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["SetMathFontSize[nb, 16]",
  FontSlant->"Italic"],
 " \[LongDash] each takes ",
 StyleBox["Automatic",
  FontSlant->"Italic"],
 " to drop its own override \[LongDash] and ",
 StyleBox["ResetDocumentView[nb]",
  FontSlant->"Italic"],
 " to drop all of them. They work on a notebook still using ",
 StyleBox["Default",
  FontSlant->"Italic"],
 " too."
}], "Item",ExpressionUUID->"0c8d2a86-f86e-4e7c-b13e-a63eef3b5bb2"],

Cell["Math Input Shortcuts", "Section",ExpressionUUID->"cb9f21dd-6cbc-4e88-ba5b-e04d83155b13"],

Cell[TextData[{
 StyleBox["Ctrl+9",
  FontWeight->"Bold"],
 " inline math in text, ",
 StyleBox["Ctrl+0",
  FontWeight->"Bold"],
 " exits."
}], "Item",ExpressionUUID->"9b6460d3-66a6-4a7a-a16a-c0f084a057fc"],

Cell[TextData[{
 StyleBox["Ctrl+/",
  FontWeight->"Bold"],
 " fraction, ",
 StyleBox["Ctrl+2",
  FontWeight->"Bold"],
 " square root."
}], "Item",ExpressionUUID->"340d49f7-fbed-4931-8fa5-f1c15628aa90"],

Cell[TextData[{
 StyleBox["Ctrl+^",
  FontWeight->"Bold"],
 " superscript, ",
 StyleBox["Ctrl+_",
  FontWeight->"Bold"],
 " subscript, ",
 StyleBox["Ctrl+%",
  FontWeight->"Bold"],
 " switches between them."
}], "Item",ExpressionUUID->"00e606c1-9a99-4bf3-b584-46e689eee8a7"],

Cell[TextData[{
 StyleBox["esc",
  FontWeight->"Bold"],
 " ",
 StyleBox["name",
  FontSlant->"Italic"],
 " ",
 StyleBox["esc",
  FontWeight->"Bold"],
 " enters symbols: ",
 StyleBox["a",
  FontSlant->"Italic"],
 " \[RightArrow] \[Alpha], ",
 StyleBox["el",
  FontSlant->"Italic"],
 " \[RightArrow] \[Element], ",
 StyleBox["->",
  FontSlant->"Italic"],
 " \[RightArrow] \[Rule]."
}], "Item",ExpressionUUID->"7b988112-a542-4f5f-b6ac-c992446d1796"],

Cell[TextData[{
 StyleBox["Cmd+Shift+E",
  FontWeight->"Bold"],
 " shows the cell expression (",
 StyleBox["Ctrl+Shift+E",
  FontWeight->"Bold"],
 " on Windows)."
}], "Item",ExpressionUUID->"d29c6dd1-2c9e-4e06-9fca-8da2a36fc2d3"],

Cell["Working with Cells", "Section",ExpressionUUID->"1300c2f0-1b26-4717-a89f-6aafae7397ef"],

Cell[TextData[{
 "Click a cell bracket to select the cell; drag across brackets to select \
several; ",
 StyleBox["Delete",
  FontWeight->"Bold"],
 " removes them."
}], "Item",ExpressionUUID->"0341a0d0-1d3e-45db-a39f-b0b6d4d4cee8"],

Cell[TextData[{
 StyleBox["Ctrl+.",
  FontWeight->"Bold"],
 " extends the selection outward; repeat to reach the whole cell."
}], "Item",ExpressionUUID->"5c34ab22-cf1c-42eb-b446-961bc120ca2d"],

Cell[TextData[{
 StyleBox["Cmd+1",
  FontWeight->"Bold"],
 "/",
 StyleBox["4",
  FontWeight->"Bold"],
 "/",
 StyleBox["5",
  FontWeight->"Bold"],
 "/",
 StyleBox["7",
  FontWeight->"Bold"],
 "/",
 StyleBox["9",
  FontWeight->"Bold"],
 " restyle a cell: Title, Section, Subsection, Text, Input."
}], "Item",ExpressionUUID->"c4ae6918-62ec-47e4-988f-fbf6d70a3af4"],

Cell[TextData[{
 StyleBox["Cmd+Shift+D",
  FontWeight->"Bold"],
 " divides a cell at the cursor; ",
 StyleBox["Cmd+Shift+M",
  FontWeight->"Bold"],
 " merges selected cells."
}], "Item",ExpressionUUID->"b0a8fa19-d3be-4bd2-a138-7e0a2799b2b2"],

Cell[TextData[{
 StyleBox["Ctrl+G",
  FontWeight->"Bold"],
 " groups selected cells; ",
 StyleBox["Ctrl+Shift+G",
  FontWeight->"Bold"],
 " ungroups."
}], "Item",ExpressionUUID->"9f15953d-ff27-4608-b01a-01dae41ad2a7"],

Cell[TextData[{
 "Double-click a group bracket to close or open the group; ",
 StyleBox["Cmd+Shift+{",
  FontWeight->"Bold"],
 " and ",
 StyleBox["Cmd+Shift+}",
  FontWeight->"Bold"],
 " open and close all subgroups."
}], "Item",ExpressionUUID->"e1bf317b-d642-45ed-b0d8-073465a977a6"],

Cell["\<\
Double-click a closed group's remaining bracket to reopen it; use Cell \
\[RightArrow] Delete All Output before sharing a notebook.\
\>", "Item",ExpressionUUID->"89308ecc-59f6-46f2-99b0-9efec483d0dc"],

Cell["LaTeX Conversion", "Section",ExpressionUUID->"7066686a-b42e-44fb-9a18-ccc7f608b37a"],

Cell[TextData[{
 "Select the cells to convert, then press ",
 StyleBox["TeX \[Rule] math",
  FontSlant->"Italic"],
 " or ",
 StyleBox["Math \[Rule] TeX",
  FontSlant->"Italic"],
 ". With nothing selected the whole notebook is converted."
}], "Item",ExpressionUUID->"f768f436-736d-4c9b-9604-9ebda9cab1be"],

Cell[TextData[{
 StyleBox["TeX \[Rule] math",
  FontSlant->"Italic"],
 " parses inline ",
 StyleBox["$\[Ellipsis]$",
  FontSlant->"Italic"],
 " and ",
 StyleBox["\\(\[Ellipsis]\\)",
  FontSlant->"Italic"],
 ", and displayed ",
 StyleBox["$$\[Ellipsis]$$",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\\[\[Ellipsis]\\]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["equation",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["align",
  FontSlant->"Italic"],
 "; the starred forms stay unnumbered, the unstarred ones become numbered \
equations."
}], "Item",ExpressionUUID->"539d2be6-bbbd-4b9f-a215-15dc667004cb"],

Cell[TextData[{
 "An ",
 StyleBox["align",
  FontSlant->"Italic"],
 " environment becomes a grid aligned on its ",
 StyleBox["&",
  FontSlant->"Italic"],
 ", so it stays editable as one equation cell."
}], "Item",ExpressionUUID->"5df0e00a-9056-4c4a-8c5e-be329948d9a1"],

Cell[TextData[{
 "Each converted cell keeps its original TeX, so ",
 StyleBox["Math \[Rule] TeX",
  FontSlant->"Italic"],
 " gives back what you typed rather than a re-serialization of the boxes. \
Anything the parser cannot read is left untouched."
}], "Item",ExpressionUUID->"24667d0b-364f-4731-8afc-4661781b8c37"],

Cell[TextData[{
 "Input, Code, and Output cells are skipped, so ",
 StyleBox["$",
  FontSlant->"Italic"],
 " in code is safe. To bring in a LaTeX paper, paste it as Text cells and \
convert."
}], "Item",ExpressionUUID->"32323806-9740-4a97-a76b-32aeb7ba9c79"],

Cell["MaTeX", "Section",ExpressionUUID->"cf3660ae-dc22-46e2-a731-1db7eb2dad60"],

Cell[TextData[{
 "MaTeX (",
 ButtonBox["github.com/szhorvat/MaTeX",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/szhorvat/MaTeX"], None},
  ButtonNote->"https://github.com/szhorvat/MaTeX"],
 ") is optional, and needs a TeX distribution and Ghostscript. It is used \
only by the MaTeX buttons; referencing, stylesheets, and LaTeX conversion do \
not."
}], "Item",ExpressionUUID->"366c83a2-cc81-46af-8de9-2c9d902c5b4b"],

Cell[TextData[{
 "Use it when an equation has to come out of real LaTeX \[LongDash] macros, \
",
 StyleBox["tikz-cd",
  FontSlant->"Italic"],
 " diagrams, exact journal metrics."
}], "Item",ExpressionUUID->"052f202a-08ca-4d91-a693-0d2c945c0f2c"],

Cell[TextData[{
 StyleBox["Install MaTeX",
  FontSlant->"Italic"],
 " installs the paclet and points it at the local ",
 StyleBox["pdflatex",
  FontSlant->"Italic"],
 " and ",
 StyleBox["gs",
  FontSlant->"Italic"],
 "."
}], "Item",ExpressionUUID->"8f0cec0d-a335-4a0f-b1c1-81ef58089b2d"],

Cell[TextData[{
 StyleBox["Math \[Rule] MaTeX",
  FontSlant->"Italic"],
 " renders the selected display equations through LaTeX; ",
 StyleBox["MaTeX \[Rule] math",
  FontSlant->"Italic"],
 " restores editable typeset math from the TeX stored in each cell."
}], "Item",ExpressionUUID->"a12ed661-4dca-4bc5-9ab2-445bc9fef363"],

Cell[TextData[{
 StyleBox["MaTeX preferences",
  FontSlant->"Italic"],
 " opens your ",
 StyleBox["init.m",
  FontSlant->"Italic"],
 " in the front end \[LongDash] deliberately not through the system handler \
for ",
 StyleBox[".m",
  FontSlant->"Italic"],
 " files. Set the preamble, the magnification, and ",
 StyleBox["$useMaTeXQ = True",
  FontSlant->"Italic"],
 " to route TeX typed into a notebook through LaTeX instead of the built-in \
parser."
}], "Item",ExpressionUUID->"2a674545-eb83-4cb8-b6be-b40e6ccdd7de"],

Cell["\<\
MaTeX cells are images: convert them back before editing, and keep rendering \
for last.\
\>", "Item",ExpressionUUID->"ebe08ff5-2162-49eb-a6a4-1b78cee1f9f8"],

Cell["Best Practices", "Section",ExpressionUUID->"a1f30368-03f5-42e9-80e4-3f8b215a3003"],

Cell["\<\
One environment per cell, inserted from the palette, keeps the styles and \
counters consistent.\
\>", "Item",ExpressionUUID->"5ffc7f0b-8a53-47f1-945f-fc7c64cd5db3"],

Cell["\<\
Tag cells as you write them; tagging a theorem after fifty pages means \
finding it again.\
\>", "Item",ExpressionUUID->"ef407588-8239-472b-9b59-99847b1c0982"],

Cell["\<\
Do not strip cell tagging rules: they hold the TeX source that makes the \
round trip lossless.\
\>", "Item",ExpressionUUID->"cbea1f69-e42e-4ce9-9cc2-2b16836a8357"],

Cell["\<\
Convert to LaTeX at submission time, not continuously \[LongDash] the \
notebook is the source.\
\>", "Item",ExpressionUUID->"775dd95b-c68b-4e46-9145-bfed9979d9b5"],

Cell[TextData[{
 "Before sharing: ",
 StyleBox["Cell \[RightArrow] Delete All Output",
  FontSlant->"Italic"],
 ", and convert MaTeX cells back to math so a coauthor can edit them."
}], "Item",ExpressionUUID->"6d191449-cda8-4bc3-825f-0aadf54239e4"],

Cell["Credits", "Section",ExpressionUUID->"5ef69529-f564-4141-a4ab-f7648220c475"],

Cell[TextData[{
 "The referencing scheme and the MaTeX integration are originally due to Nik \
Murzin, ",
 ButtonBox["github.com/sw1sh",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/sw1sh"], None},
  ButtonNote->"https://github.com/sw1sh"],
 "; this paclet packages and extends that work."
}], "Text",ExpressionUUID->"e97d6b8d-ff01-472c-9992-aeccec9dba4c"],

Cell[TextData[{
 "Nik Murzin, ",
 ButtonBox["https://github.com/sw1sh",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/sw1sh"], None},
  ButtonNote->"https://github.com/sw1sh"]
}], "Reference",ExpressionUUID->"2ee8e651-f4f0-4965-97cb-2a9040e2e0a5"],

Cell[TextData[{
 "Szabolcs Horvat, MaTeX: LaTeX labels in Mathematica, ",
 ButtonBox["https://github.com/szhorvat/MaTeX",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/szhorvat/MaTeX"], None},
  ButtonNote->"https://github.com/szhorvat/MaTeX"]
}], "Reference",ExpressionUUID->"01365318-4deb-437b-9093-305efa9a97d1"],

Cell[TextData[{
 "TeX Live, ",
 ButtonBox["https://tug.org/texlive/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/texlive/"], None},
  ButtonNote->"https://tug.org/texlive/"],
 " \[LongDash] on macOS, MacTeX, ",
 ButtonBox["https://tug.org/mactex/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://tug.org/mactex/"], None},
  ButtonNote->"https://tug.org/mactex/"]
}], "Reference",ExpressionUUID->"a8c72a70-73e7-4b38-b957-c45c99963bda"],

Cell[TextData[{
 "Latin Modern, ",
 ButtonBox["https://ctan.org/pkg/lm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://ctan.org/pkg/lm"], None},
  ButtonNote->"https://ctan.org/pkg/lm"],
 " and TeX Gyre, ",
 ButtonBox["https://ctan.org/pkg/tex-gyre",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://ctan.org/pkg/tex-gyre"], None},
  ButtonNote->"https://ctan.org/pkg/tex-gyre"]
}], "Reference",ExpressionUUID->"ce9d9e22-1249-4190-a3ec-c260554ad783"]
},
LightDark->"Light",
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (May 19, 2026)",
StyleDefinitions->FrontEnd`FileName[{"MathNotebook"}, "AMSArticle.nb", 
  CharacterEncoding -> "UTF-8"],
ExpressionUUID->"b7d60ec6-fb49-48d2-a9b0-b3275d6ca267"
]
(* End of Notebook Content *)

