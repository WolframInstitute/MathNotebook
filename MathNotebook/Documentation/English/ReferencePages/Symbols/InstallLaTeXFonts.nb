Notebook[{

Cell[CellGroupData[{
Cell["InstallLaTeXFonts", "ObjectName",
 CellID->592734136,ExpressionUUID->"8dfd7096-ce62-437f-afb3-badf61b11e26"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"76ba6b94-fc7c-4c2e-a79a-dfd2fc522dcb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["InstallLaTeXFonts",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/InstallLaTeXFonts"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "1f757171-d1f5-4336-896f-8e7d1a0f4043"],
 " \[LineSeparator]",
 "installs Latin Modern and TeX Gyre OpenType fonts from the local TeX Live \
distribution."
}], "Usage",
 CellID->778863908,ExpressionUUID->"684dda96-6141-4019-a8a8-b5137ede62db"],

Cell["\<\
Requires a TeX Live distribution already present on the machine; the fonts \
are copied from it rather than downloaded.\
\>", "Notes",
 CellID->907343309,ExpressionUUID->"139f0a8b-ef24-408d-aa7b-7e89869df02b"],

Cell["\<\
The MathNotebook journal stylesheets ask for these fonts by name. Without \
them installed the front end substitutes, and a notebook will not look like \
the journal it is styled after.\
\>", "Notes",
 CellID->509380860,ExpressionUUID->"dbda72a0-569d-4b1f-9cbf-e809eab76a1c"],

Cell["\<\
Installed fonts are picked up by the front end after a restart.\
\>", "Notes",
 CellID->220468557,ExpressionUUID->"ca658eda-cbae-47a0-a109-dce7e6bbf867"],

Cell["Run once per machine.", "Notes",
 CellID->115037848,ExpressionUUID->"6882e0b6-b0f9-422e-9130-4a9b74e29495"]
}, Open  ]],

