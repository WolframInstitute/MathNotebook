Notebook[{

Cell[CellGroupData[{
Cell["SetDocumentFontSize", "ObjectName",
 CellID->9623138,ExpressionUUID->"13d3949c-c763-4806-9735-1945e70eaa6a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"14abead8-57e2-d3f8-79a1-5d59ce1d44ce"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SetDocumentFontSize",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/SetDocumentFontSize"], 
   RowBox[{"[", "size", "]"}]}]], "InlineFormula",ExpressionUUID->
  "1b4010c9-b3b3-7956-e632-7f4705c36bfd"],
 " \[LineSeparator]",
 "scales the input notebook so that Text is the given font ",
 Cell[BoxData[
  StyleBox["size", "TI"]], "InlineFormula",ExpressionUUID->
  "986eb78e-d6a3-56c8-0e4e-82323dd500b5"],
 ", on screen and in print, carrying its mathematics with it unless SetMathFontSize has been given a ",
 Cell[BoxData[
  StyleBox["size", "TI"]], "InlineFormula",ExpressionUUID->
  "10381d81-38b3-7045-6408-6c08cbbb3d75"],
 " of its own.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["SetDocumentFontSize",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/SetDocumentFontSize"], 
   RowBox[{"[", 
    RowBox[{"notebook", ", ", " ", "size"}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "6b277c01-09f2-9a9b-c34e-30526cc5ae3b"],
 " \[LineSeparator]",
 "scales the given ",
 Cell[BoxData[
  StyleBox["notebook", "TI"]], "InlineFormula",ExpressionUUID->
  "1d633ff6-9354-80f3-2e53-3d3ed558de21"],
 ".",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["SetDocumentFontSize",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/SetDocumentFontSize"], 
   RowBox[{"[", 
    RowBox[{"notebook", ", ", " ", "Automatic"}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "a4f8c529-e295-c604-4102-7f3f1c6ba03f"],
 " \[LineSeparator]",
 "removes the override."
}], "Usage",
 CellID->311254668,ExpressionUUID->"4db299af-0f12-497f-87e2-af33bf769312"],

Cell[TextData[{
 StyleBox["notebook",
  FontSlant->Italic],
 " is an open ",
 Cell[BoxData[
  TemplateBox[{
   "NotebookObject", "paclet:ref/NotebookObject", 
    "https://reference.wolfram.com/language/ref/NotebookObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "05a3732f-9518-432f-9869-30f3511b39b8"],
 ", so the function acts on the front end and does nothing in a kernel with \
no front end."
}], "Notes",
 CellID->656888016,ExpressionUUID->"3e214d4c-419b-42fe-827f-ec091be7e6df"],

Cell["\<\
Every prose style is scaled by the ratio the requested Text size implies, so \
the relative sizes the stylesheet sets are preserved rather than flattened.\
\>", "Notes",
 CellID->255520443,ExpressionUUID->"40740816-9e43-4c3a-86f7-d10ccf768d11"],

Cell["\<\
The override is written for both the screen and the printout variant of each \
style. A printout variant wins over the bare style name across the whole \
stylesheet chain, so writing only one would change the screen and leave the \
PDF untouched.\
\>", "Notes",
 CellID->316030622,ExpressionUUID->"cb81bd4c-a6f8-4291-aa74-e53fc7af0a75"],

Cell[TextData[{
 "The override is installed as a private stylesheet, which is the only form \
the front end honours. Setting the value with ",
 Cell[BoxData[
  TemplateBox[{
   "CurrentValue", "paclet:ref/CurrentValue", 
    "https://reference.wolfram.com/language/ref/CurrentValue.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "9e492430-3989-4b84-b49f-284186673958"],
 " on a style is silently ignored."
}], "Notes",
 CellID->533660283,ExpressionUUID->"ea8b05d6-a681-43f1-9031-5ea1a571cc46"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  TemplateBox[{
   "ResetDocumentView", 
    "paclet:WolframInstitute/MathNotebook/ref/ResetDocumentView", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
ResetDocumentView.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "157f838f-7829-46ae-947b-018a96ea0ac2"],
 " to remove this and every other view override at once."
}], "Notes",
 CellID->54526280,ExpressionUUID->"c358865f-3d78-4270-ad40-ff8269498120"]
}, Open  ]],

