Notebook[{

Cell[CellGroupData[{
Cell["ResetDocumentView", "ObjectName",
 CellID->18755391,ExpressionUUID->"9dc16008-a985-4c75-9fa0-ae1d1ecf5c8b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0f7f9f80-d83b-41eb-825e-bf8564284045"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ResetDocumentView",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ResetDocumentView"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "085ea551-3ff5-4443-9913-4a8ea58558d9"],
 " \[LineSeparator]",
 "returns the input notebook to its stylesheet defaults, leaving no trace of \
the view overrides.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ResetDocumentView",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ResetDocumentView"], 
   RowBox[{"[", "notebook", "]"}]}]], "InlineFormula",ExpressionUUID->
  "79d1f3c0-65ca-4cca-adb4-efa1478420ef"],
 " \[LineSeparator]",
 "resets the given notebook.",
 Cell["   ", "ModInfo",ExpressionUUID->
  "a5187380-1363-48db-bc29-7e2ea0d6afdc"]
}], "Usage",
 CellID->938993639,ExpressionUUID->"4573ffd0-4121-4e98-9bf6-ca7d0af0f956"],

Cell[TextData[{
 StyleBox["notebook",
  FontSlant->Italic],
 " is an open ",
 Cell[BoxData[
  TemplateBox[{
   "NotebookObject", "paclet:ref/NotebookObject", 
    "https://reference.wolfram.com/language/ref/NotebookObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "692f1947-4099-4139-b62b-9b3f49e46880"],
 ", so the function acts on the front end and does nothing in a kernel with \
no front end."
}], "Notes",
 CellID->664479737,ExpressionUUID->"a8c5fcde-33c8-41aa-bf56-c41e6f7c999c"],

Cell[TextData[{
 "Removes the private stylesheet installed by ",
 Cell[BoxData[
  TemplateBox[{
   "SetDocumentFontSize", 
    "paclet:WolframInstitute/MathNotebook/ref/SetDocumentFontSize", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
SetDocumentFontSize.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "c858ab26-fa33-4b90-b1f2-64b220663fef"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
   "SetMathFontSize", 
    "paclet:WolframInstitute/MathNotebook/ref/SetMathFontSize", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
SetMathFontSize.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "86d84aa5-69a2-4c8a-bbf5-712d1d652143"],
 " and restores the notebook's real parent stylesheet."
}], "Notes",
 CellID->403964428,ExpressionUUID->"90ea13f8-1136-40b9-ad98-adff8d2ddee4"],

Cell["\<\
The generated sheet is recognised by a hidden marker cell rather than by \
tagging rules, because the front end drops tagging rules from a private \
stylesheet. Without that marker each install would nest the previous sheet \
inside the new one and the real parent could no longer be recovered.\
\>", "Notes",
 CellID->373742273,ExpressionUUID->"085b0305-6c2e-4758-bfb8-0281f4cd93b0"],

Cell["\<\
Also clears the \"ContentWidth\" tagging rule written by the withdrawn \
content-width control in versions 0.1.5 to 0.1.7, so documents written with \
those versions are left clean.\
\>", "Notes",
 CellID->616431801,ExpressionUUID->"956ae9b3-80fd-4e2a-b7a0-a1798528d261"]
}, Open  ]],

