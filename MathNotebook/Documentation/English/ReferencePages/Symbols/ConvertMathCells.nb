Notebook[{

Cell[CellGroupData[{
Cell["ConvertMathCells", "ObjectName",
 CellID->145996530,ExpressionUUID->"eae4cd27-f2c3-4c23-89cc-d3a54fa8ec1a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"692105eb-a468-4cc1-b499-e1ec14b6322e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertMathCells",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertMathCells"], 
   
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "30ca1bc1-80b2-4830-863e-73030f6b2fba"],
 " \[LineSeparator]",
 "converts native typeset math in the selected cells into LaTeX fragments, or \
in the whole input notebook if nothing is selected.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertMathCells",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertMathCells"], 
   
   RowBox[{"[", "notebook", "]"}]}]], "InlineFormula",ExpressionUUID->
  "b117c8ac-8e85-47c1-984a-5c087f50cede"],
 " \[LineSeparator]",
 "converts the given notebook.",
 Cell["   ", "ModInfo",ExpressionUUID->"0847a25e-8a94-4d84-84f1-0f12bf854ae1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertMathCells",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertMathCells"], 
   
   RowBox[{"[", 
    RowBox[{"{", 
     RowBox[{"cell", ",", " ", "..."}], "}"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"2b10f372-b29a-4abf-a92d-441a23432ca9"],
 " \[LineSeparator]",
 "converts the given cells."
}], "Usage",
 CellID->106163593,ExpressionUUID->"56435e89-292b-4fba-9837-68523caa1690"],

Cell[TextData[{
 StyleBox["notebook",
  FontSlant->Italic],
 " is an open ",
 Cell[BoxData[
  TemplateBox[{
   "NotebookObject", "paclet:ref/NotebookObject", 
    "https://reference.wolfram.com/language/ref/NotebookObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "6f0ab3bb-e053-4735-81e9-168750bd5238"],
 " and ",
 StyleBox["cell",
  FontSlant->Italic],
 " is a ",
 Cell[BoxData[
  TemplateBox[{
   "CellObject", "paclet:ref/CellObject", 
    "https://reference.wolfram.com/language/ref/CellObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "a936706a-9041-455e-8fcd-36fee455467d"],
 ", so every form acts on the front end. The function does nothing in a \
kernel with no front end."
}], "Notes",
 CellID->816331184,ExpressionUUID->"1f0bd856-b4b6-4dd2-92d1-f044a1228dd9"],

Cell[TextData[{
 "This is the inverse of ",
 Cell[BoxData[
  TemplateBox[{
   "ConvertLaTeXCells", 
    "paclet:WolframInstitute/MathNotebook/ref/ConvertLaTeXCells", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
ConvertLaTeXCells.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "2d84f98a-6292-4d95-a262-95d799665233"],
 ". Where the original LaTeX source was recorded on the cell it is restored \
verbatim rather than regenerated."
}], "Notes",
 CellID->425587623,ExpressionUUID->"d4fc0d5b-523a-4c1d-8085-4418967fd67f"],

Cell["\<\
Math that was never imported from LaTeX is written out from its boxes \
instead, which is correct but need not match what a human would have typed.\
\>", "Notes",
 CellID->726741213,ExpressionUUID->"06a15fa8-cd5f-403c-988a-601395068048"]
}, Open  ]],

