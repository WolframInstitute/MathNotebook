Notebook[{

Cell[CellGroupData[{
Cell["OpenMaTeXPreferences", "ObjectName",
 CellID->442324926,ExpressionUUID->"c62cc9dc-baf9-4242-acfd-7821899dc75d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d0956e71-176e-478e-a8a8-c852dacfa7c2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["OpenMaTeXPreferences",
    BaseStyle->"Link",
    ButtonData->
     "paclet:WolframInstitute/MathNotebook/ref/OpenMaTeXPreferences"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "352bbad2-b379-4143-9fe4-a635b1820845"],
 " \[LineSeparator]",
 "opens the user init.m file in the front end, creating it with a MaTeX \
preferences template if absent."
}], "Usage",
 CellID->448802521,ExpressionUUID->"33de6a17-7aeb-4754-97f1-ecfd155844c1"],

Cell["\<\
Opens a file in the front end, so it does nothing in a kernel with no front \
end.\
\>", "Notes",
 CellID->455149648,ExpressionUUID->"df6907ea-7359-4af8-83f0-f5497210f140"],

Cell["\<\
The template it writes holds the paths MaTeX uses to find the local LaTeX \
distribution. Edit it when LaTeX lives somewhere non-standard or a different \
distribution should be used.\
\>", "Notes",
 CellID->553889522,ExpressionUUID->"c614f403-252a-4f8e-b2e8-2451f5cb2a5c"],

Cell["Settings in init.m take effect in the next kernel session.", "Notes",
 CellID->862120912,ExpressionUUID->"469754c1-1b7c-4c26-9564-4b930ca83ec7"]
}, Open  ]],

