Notebook[{

Cell[CellGroupData[{
Cell["InsertFrontMatter", "ObjectName",
 CellID->267158081,ExpressionUUID->"02905f1d-904f-4af0-b2b7-cb532c15c8d1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"13e87dc7-42b7-7e76-8b1c-d3c1f108cfe9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["InsertFrontMatter",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/InsertFrontMatter"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "ebde9750-a8fe-5b78-459b-894ced7a12cb"],
 " \[LineSeparator]",
 "inserts empty Title, Author and Abstract cells at the top of the document and puts the cursor in the Title. The three export as \\title, \\author and an abstract environment, in the order \\maketitle needs them.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["InsertFrontMatter",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/InsertFrontMatter"], 
   RowBox[{"[", "notebook", "]"}]}]], "InlineFormula",ExpressionUUID->
  "c97ef05f-a545-631f-110b-3596e2938013"],
 " \[LineSeparator]",
 "inserts them into the given ",
 Cell[BoxData[
  StyleBox["notebook", "TI"]], "InlineFormula",ExpressionUUID->
  "a38dc2e6-9a07-cdd9-28f6-3e55b1310c2b"],
 "."
}], "Usage",
 CellID->193565921,ExpressionUUID->"f3cda871-a01c-4f97-9357-60a89380569d"],

Cell[TextData[{
 "Acts on the current position in the front end. There is no result to \
compute, and the function does nothing in a kernel with no front end. ",
 StyleBox["style",
  FontSlant->Italic],
 " is a style name such as \"Theorem\", \"Definition\", \"Lemma\", \"Proof\" \
or \"Remark\", or one of the symbols ",
 Cell[BoxData[Cell["DisplayFormula",
   Background->None,ExpressionUUID->"21f04d1e-4755-4bbf-ba6e-c2ac765a6f43"]], 
  "InlineCode",ExpressionUUID->"cb2e89e6-c8b1-4251-87e9-9c38255e2d07"],
 " and ",
 Cell[BoxData[Cell["DisplayFormulaNumbered",
   Background->None,ExpressionUUID->"d609905a-aee0-464b-83a5-e8f90bcbf92c"]], 
  "InlineCode",ExpressionUUID->"828f58d0-6093-4546-8147-f2a77b9df804"],
 "."
}], "Notes",
 CellID->689863300,ExpressionUUID->"eeaeaeef-abc6-4df8-873d-5872f40a5f1b"],

Cell["\<\
Numbered environments carry their counter in the stylesheet, so they number \
themselves and renumber when cells move. Numbering only works under a \
MathNotebook stylesheet; on the default stylesheet the counter has nothing to \
increment.\
\>", "Notes",
 CellID->858572256,ExpressionUUID->"91d779b6-afa9-46a0-ba50-2d97207397b9"],

Cell[TextData[{
 "Tag the inserted cell with ",
