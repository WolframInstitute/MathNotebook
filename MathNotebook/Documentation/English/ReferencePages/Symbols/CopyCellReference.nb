Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a4efaae6-7f01-df73-9e60-6dd969ab8faa"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CopyCellReference",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/CopyCellReference"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "750a6ceb-08a6-7e8f-2af1-2c2b2aa93920"],
 " \[LineSeparator]",
 "copies a live, clickable reference to the selected cell to the clipboard.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["CopyCellReference",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/CopyCellReference"], 
   RowBox[{"[", "notebook", "]"}]}]], "InlineFormula",ExpressionUUID->
  "a2de2e90-ef49-ae48-f65f-543376df55ff"],
 " \[LineSeparator]",
 "copies a reference to the selected cell of the given ",
 Cell[BoxData[
  StyleBox["notebook", "TI"]], "InlineFormula",ExpressionUUID->
  "cb579c14-db1b-f5a7-d94d-072acc6ed80f"],
 "."
}], "Usage",
 CellID->198919063,ExpressionUUID->"f01fc643-f3fb-472d-bf99-421ac96185c7"],

Cell["\<\
Acts on the current selection in the front end. There is no result to \
compute, and the function does nothing in a kernel with no front end.\
\>", "Notes",
 CellID->465237051,ExpressionUUID->"ec35fbfb-f6f6-4c2e-b360-73f574ce5293"],

Cell[TextData[{
 "The reference is keyed on the cell's ",
 Cell[BoxData[
  TemplateBox[{
   "CellID", "paclet:ref/CellID", 
    "https://reference.wolfram.com/language/ref/CellID.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "88c7dbea-3fed-4184-ae7a-41e794d95d14"],
 ", so it keeps pointing at the same cell when cells are moved or \
renumbered."
}], "Notes",
 CellID->561030456,ExpressionUUID->"43399d36-2782-4870-976f-838df1d0afe6"],

Cell[TextData[{
 "Because it is keyed on a ",
 Cell[BoxData[
  TemplateBox[{
   "CellID", "paclet:ref/CellID", 
    "https://reference.wolfram.com/language/ref/CellID.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "fdb6fea7-d519-4d9d-a790-c3f693d56850"],
 " rather than a cell tag, the copied reference is not a citation. Use ",
 Cell[BoxData[
  TemplateBox[{
   "InsertCitation", 
    "paclet:WolframInstitute/MathNotebook/ref/InsertCitation", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
InsertCitation.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "01280310-f8a5-42e3-a29d-115e1e2a6bd2"],
 " to cite a tagged, numbered environment."
}], "Notes",
 CellID->645171883,ExpressionUUID->"8ab34817-1750-4980-8769-835b70b5769c"],

Cell[TextData[{
 "Following the pasted reference sets the cell that ",
 Cell[BoxData[
  TemplateBox[{
   "GoBack", "paclet:WolframInstitute/MathNotebook/ref/GoBack", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
GoBack.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "64398b45-c0cf-4c6a-8552-28e3494231b4"],
 " returns to."
}], "Notes",
 CellID->128739286,ExpressionUUID->"9327e168-3d8f-45db-bdf5-7c80aede4de1"]
}, Open  ]],

