Cell["\<\
Import a paper, then write it out with everything it needs to compile:\
\>", "ExampleText",ExpressionUUID->"3d6c5b4c-62f4-4641-aab6-f3c85fe75818"],

Cell[BoxData[
 RowBox[{
  RowBox[{"nb", "=", 
   RowBox[{"ImportLaTeXDocument", "[", "\"\<paper.tex\>\"", "]"}]}], ";", 
  RowBox[{"bundle", "=", 
   RowBox[{"ExportLaTeXBundle", "[", 
    RowBox[{"nb", ",", " ", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"$TemporaryDirectory", ",", " ", "\"\<submission\>\""}], "}"}],
       "]"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"bb80b5cd-3341-4deb-9cf5-6794c4ee37fa"],

Cell["", "ExampleDelimiter",ExpressionUUID->"3d1a6533-dfa8-4c99-b8de-a977123b198c"],

Cell["\<\
The result names every file written, and everything the paper named that was \
not found:\
\>", "ExampleText",ExpressionUUID->"1ae4ca79-7f66-4f3b-b3b7-b3959c7b278a"],

Cell[BoxData[
 RowBox[{"bundle", "[", 
  RowBox[{"{", 
