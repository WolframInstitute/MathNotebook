Notebook[{

Cell[CellGroupData[{
Cell["ImportLaTeXDocument", "ObjectName",
 CellID->539121906,ExpressionUUID->"4d3d30da-6fbb-4631-a342-36b23e2129c2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4316c78f-08c5-4561-963a-0ad86be653e3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ImportLaTeXDocument",
    BaseStyle->"Link",
    ButtonData->
     "paclet:WolframInstitute/MathNotebook/ref/ImportLaTeXDocument"], 
   RowBox[{"[", "\"\<file.tex\>\"", "]"}]}]], "InlineFormula",ExpressionUUID->
  "f381a4c7-9c15-43c2-b382-4e752251e0df"],
 " \[LineSeparator]",
 "reads the LaTeX paper ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"file", ".", "tex"}], "TI"]], "InlineFormula",ExpressionUUID->
  "14baaf3c-1c00-41e5-b6f2-b8c1355a19cf"],
 " as a Notebook expression."
}], "Usage",
 CellID->519867208,ExpressionUUID->"9d505847-1388-489a-bdec-80137778052d"],

Cell["\<\
Sectioning commands and theorem-like environments become cells of the \
corresponding MathNotebook style, and mathematics is converted to native \
typeset boxes.\
\>", "Notes",
 CellID->225560035,ExpressionUUID->"a66e0f16-7533-4892-ad5c-d947bb9b35e9"],

Cell[TextData[{
 "Everything the importer does not interpret is carried verbatim, so ",
 Cell[BoxData[
  TemplateBox[{
   "ExportLaTeXDocument", 
    "paclet:WolframInstitute/MathNotebook/ref/ExportLaTeXDocument", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
ExportLaTeXDocument.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "0b28906d-1655-4eed-9b39-98e0431885e5"],
 " returns the source unchanged."
}], "Notes",
 CellID->931665605,ExpressionUUID->"3074ec38-3bd3-49eb-bac5-975140df47e6"],

Cell[TextData[{
 "The result is a ",
 Cell[BoxData[
  TemplateBox[{
   "Notebook", "paclet:ref/Notebook", 
    "https://reference.wolfram.com/language/ref/Notebook.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "2b92fe5a-ad6d-4d24-b96d-16dc391028e0"],
 " expression, not an open notebook; use ",
 Cell[BoxData[
  TemplateBox[{
   "NotebookPut", "paclet:ref/NotebookPut", 
    "https://reference.wolfram.com/language/ref/NotebookPut.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "22c04b63-1b7a-4d52-91df-949d1b1b4a94"],
 " to open it."
}], "Notes",
 CellID->459286715,ExpressionUUID->"76e6ce7c-d1ec-46ab-be1e-7c056999d47e"],

Cell[TextData[{
 "Mathematics is converted by the same machinery as ",
 Cell[BoxData[
  TemplateBox[{
   "ConvertLaTeXCells", 
    "paclet:WolframInstitute/MathNotebook/ref/ConvertLaTeXCells", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
ConvertLaTeXCells.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "77d8d037-8da4-4d1c-87db-a3252e23fb54"],
 ": fragments that are a single Wolfram expression are parsed as one, and the \
rest fall back to presentational boxes."
}], "Notes",
 CellID->329919665,ExpressionUUID->"fd2c7a30-5c84-4526-bb2c-4423ffb7ec35"],

Cell["\<\
Cross-references written with \\ref and \\eqref become front end counter \
boxes, which only number correctly under a MathNotebook stylesheet.\
\>", "Notes",
 CellID->305591646,ExpressionUUID->"bf22ca22-fe27-4546-b28c-607f2858d07d"]
}, Open  ]],

