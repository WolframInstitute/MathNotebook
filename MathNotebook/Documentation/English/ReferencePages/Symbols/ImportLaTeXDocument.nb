Cell["Write a small LaTeX source file:", "ExampleText",
 CellID->797293240,ExpressionUUID->"5d555636-5252-437e-b9b8-1610e43ea9b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"file", "=", 
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"$TemporaryDirectory", ",", "\"\<sample.tex\>\""}], "}"}], 
     "]"}], ",", "\"\<\\\\section{Introduction}\\nLet $G = (V, E)$ be a graph \
with $|V| = n$ vertices.\\n\\n\\\\begin{theorem}\\nThe degree sum is \
$2|E|$.\\n\\\\end{theorem}\\n\>\"", ",", "\"\<Text\>\""}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
