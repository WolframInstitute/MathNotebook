Cell[BoxData["\<\"/private/var/folders/g9/0_n55jxd3h33l8y8fg68b8kh0000gn/T/\
sample.tex\"\>"], "Output",
 CellLabel->"Out[1]=",
 CellID->100201348,ExpressionUUID->"f4db8604-e29f-4d26-924a-da7d314888e7"]
