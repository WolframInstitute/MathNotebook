Notebook[{

Cell[CellGroupData[{
Cell["UpdateMathNotebook", "ObjectName",
 CellID->548424861,ExpressionUUID->"004acc99-189b-4f2d-b1b1-ce8e651ffd4e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e47fd184-4016-4d3a-9393-2b187f35f351"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UpdateMathNotebook",
    BaseStyle->"Link",
    ButtonData->
     "paclet:WolframInstitute/MathNotebook/ref/UpdateMathNotebook"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "dbbfbdd6-6a0d-4c09-addd-7a683134e382"],
 " \[LineSeparator]",
 "installs the MathNotebook paclet from the Wolfram Cloud when the published \
version is newer than the installed one, then rebuilds the front end menus \
and reopens the palette."
}], "Usage",
 CellID->94993052,ExpressionUUID->"df7f3654-7d92-41b5-b94e-6335bee8a784"],

Cell["\<\
Requires network access, and needs a front end to rebuild the menus and \
reopen the palette.\
\>", "Notes",
 CellID->950036039,ExpressionUUID->"cf4e9a45-1569-47c9-9c4e-9a0c1fea2d57"],

Cell[TextData[{
 "The published version is read from ",
 Cell[BoxData[
  TemplateBox[{
   "$MathNotebookCloudVersion", 
    "paclet:WolframInstitute/MathNotebook/ref/$MathNotebookCloudVersion", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
$MathNotebookCloudVersion.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "08e84829-8267-4938-ab8d-9bd1541a982f"],
 ". When the cloud cannot be reached the function reports that and installs \
nothing."
}], "Notes",
 CellID->709380821,ExpressionUUID->"cc73d0b4-7d34-415b-a180-c480bb5d0ed7"],

Cell["\<\
Versions are compared as integer lists, not as strings, so 0.1.12 is \
correctly newer than 0.1.9.\
\>", "Notes",
 CellID->346161945,ExpressionUUID->"5b65ac36-e2a7-4025-8ef3-7e6efc57a190"],

Cell["\<\
The menu rebuild is what makes newly shipped stylesheets resolve by name. \
Without it a new stylesheet stays invisible until the front end is restarted.\
\
\>", "Notes",
 CellID->993580626,ExpressionUUID->"7742a9e4-e3c9-4cfe-b831-a156012604d8"],

Cell["\<\
The cloud marker is served with a short cache lifetime, so a version read \
immediately after a publish may still be the previous one.\
\>", "Notes",
 CellID->494199324,ExpressionUUID->"fe7d66f3-af91-4c49-bce9-b36930e60e2a"]
}, Open  ]],

