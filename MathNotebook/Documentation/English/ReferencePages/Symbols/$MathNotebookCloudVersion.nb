Notebook[{

Cell[CellGroupData[{
Cell["$MathNotebookCloudVersion", "ObjectName",
 CellID->752211576,ExpressionUUID->"ccbb8ecc-1ac8-4818-9917-19f8e6b080c7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b699d211-3124-46db-afe2-72ae018cda66"],
 Cell[BoxData[
  ButtonBox["$MathNotebookCloudVersion",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/MathNotebook/ref/$MathNotebookCloudVersion"]], 
  "InlineFormula",ExpressionUUID->"3761dac2-c8d0-4a30-8566-8fd8d27b9734"],
 " \[LineSeparator]",
 "is the paclet version published in the Wolfram Cloud, or \
`Missing[\"CloudUnreachable\", ...]` when the version marker cannot be read."
}], "Usage",
 CellID->740689691,ExpressionUUID->"c5573acf-52ca-4447-9e0b-e9bcf99fe7e1"],

Cell[TextData[{
 "Reading it makes a network request, so it is not instantaneous and it fails \
to a ",
 Cell[BoxData[
  TemplateBox[{
   "Missing", "paclet:ref/Missing", 
    "https://reference.wolfram.com/language/ref/Missing.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "98b2c42c-ebbc-4cba-9fdc-7bf8eef9c022"],
 " result rather than an error when the cloud is unreachable."
}], "Notes",
 CellID->511168157,ExpressionUUID->"f15f5628-a4f6-4a2d-936e-0735f03d3b9e"],

Cell[TextData[{
 "The marker is served with a short cache lifetime, so two reads seconds \
apart can disagree and a read taken immediately after a publish may still \
report the previous version. Bind the value once rather than reading it twice \
and comparing. ",
 Cell[BoxData[
  TemplateBox[{
   "UpdateMathNotebook", 
    "paclet:WolframInstitute/MathNotebook/ref/UpdateMathNotebook", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
UpdateMathNotebook.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "1af26530-4217-4627-abc4-e4912b8daf36"],
 " uses it to decide whether an update is available."
}], "Notes",
 CellID->83589721,ExpressionUUID->"cdfe0cca-ad84-40fa-aec1-4247e1c0ba57"]
}, Open  ]],

