Notebook[{

Cell[CellGroupData[{
Cell["InsertEnvironment", "ObjectName",
 CellID->713000168,ExpressionUUID->"ada97ddb-7f12-4e6b-8d11-b8fa70b631b4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"caa2b458-45d8-4f81-abf7-e7242fe705e9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["InsertEnvironment",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/InsertEnvironment"], 
   RowBox[{"[", "style", "]"}]}]], "InlineFormula",ExpressionUUID->
  "69cb060e-0d4a-4427-86a5-ae10a9573bdb"],
 " \[LineSeparator]",
 "inserts a new cell of the environment style ",
 Cell[BoxData[
  StyleBox["style", "TI"]], "InlineFormula",ExpressionUUID->
  "61570776-f29b-4e90-bc01-8d8772c2d125"],
 " at the current position."
}], "Usage",
 CellID->862098484,ExpressionUUID->"1fa7b0c1-0c77-4d86-b75e-d224148c2e68"],

Cell[TextData[{
 "Acts on the current position in the front end. There is no result to \
compute, and the function does nothing in a kernel with no front end. ",
 StyleBox["style",
  FontSlant->Italic],
 " is a style name such as \"Theorem\", \"Definition\", \"Lemma\", \"Proof\" \
or \"Remark\", or one of the symbols ",
 Cell[BoxData[Cell["DisplayFormula",
   Background->None,ExpressionUUID->"479a2e34-1ce4-4d70-b87e-bf7c9d454c14"]], 
  "InlineCode",ExpressionUUID->"b10ed639-1e08-423d-99fb-c03c3fb6c424"],
 " and ",
 Cell[BoxData[Cell["DisplayFormulaNumbered",
   Background->None,ExpressionUUID->"aee82271-5008-4068-ab34-961459ec866a"]], 
  "InlineCode",ExpressionUUID->"c0631a44-232a-47c0-af26-d75d27e42fb9"],
 "."
}], "Notes",
 CellID->360642576,ExpressionUUID->"c5c05f75-614f-425a-9ff3-3bcff9179bd3"],

Cell["\<\
Numbered environments carry their counter in the stylesheet, so they number \
themselves and renumber when cells move. Numbering only works under a \
MathNotebook stylesheet; on the default stylesheet the counter has nothing to \
increment.\
\>", "Notes",
 CellID->850191074,ExpressionUUID->"7e551161-81ae-498d-bf2c-924f63ebc1ca"],

Cell[TextData[{
 "Tag the inserted cell with ",
 Cell[BoxData[
  TemplateBox[{
   "TagSelectedCell", 
    "paclet:WolframInstitute/MathNotebook/ref/TagSelectedCell", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
TagSelectedCell.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "f963f4f5-0b47-4f2b-ab65-6ba3a01b4c41"],
 " to make it citable."
}], "Notes",
 CellID->798934039,ExpressionUUID->"5c2449d7-ad7c-4537-b68d-12ebe09ab09e"]
}, Open  ]],

