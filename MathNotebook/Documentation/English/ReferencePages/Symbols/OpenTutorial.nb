Notebook[{

Cell[CellGroupData[{
Cell["OpenTutorial", "ObjectName",
 CellID->647028116,ExpressionUUID->"c8dfead8-086a-43f2-9dcd-b0c9b9d95e8f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"181d1554-23ec-4620-89e8-999d1991cc82"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["OpenTutorial",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/OpenTutorial"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "bd176420-4edc-4ce6-be32-4c87328b8ca9"],
 " \[LineSeparator]",
 "opens a copy of the MathNotebook tutorial notebook."
}], "Usage",
 CellID->787530807,ExpressionUUID->"c963b0b7-0216-4e70-bde1-6b651c5cf929"],

Cell["\<\
Opens a notebook in the front end, so it does nothing in a kernel with no \
front end.\
\>", "Notes",
 CellID->120231943,ExpressionUUID->"2b7cedb1-cabc-4675-947b-33165d4d220b"],

Cell["\<\
A copy is opened rather than the shipped file, so the tutorial can be \
evaluated and edited freely and the original is never modified.\
\>", "Notes",
 CellID->855119863,ExpressionUUID->"23254068-0453-4f32-9bfd-2d74a8c82aef"],

Cell["\<\
The tutorial ships as a paclet asset, so it is always the version that came \
with the installed paclet.\
\>", "Notes",
 CellID->591799549,ExpressionUUID->"5a37eaa1-6c6c-4e3f-931e-3c866ced18b3"]
}, Open  ]],

