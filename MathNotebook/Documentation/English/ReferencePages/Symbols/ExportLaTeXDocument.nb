Cell[CellGroupData[{
Cell["ExportLaTeXDocument", "ObjectName",
 CellID->239950681,ExpressionUUID->"5c0a71b4-5e0c-46f3-8382-2623120cec90"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ebcceb96-1ac1-4762-a7d6-7bfc73a53fec"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportLaTeXDocument",
    BaseStyle->"Link",
    ButtonData->
     "paclet:WolframInstitute/MathNotebook/ref/ExportLaTeXDocument"], 
   RowBox[{"[", "notebook", "]"}]}]], "InlineFormula",ExpressionUUID->
  "7bcfe9eb-3d68-4922-8e44-87ebd0b10e51"],
 " \[LineSeparator]",
 "writes a notebook read by \
[ImportLaTeXDocument](paclet:WolframInstitute/MathNotebook/ref/\
ImportLaTeXDocument) back out as LaTeX source.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportLaTeXDocument",
    BaseStyle->"Link",
    ButtonData->
     "paclet:WolframInstitute/MathNotebook/ref/ExportLaTeXDocument"], 
   RowBox[{"[", 
    RowBox[{"notebook", ",", " ", "\"\<file.tex\>\""}], "]"}]}]], 
  "InlineFormula",ExpressionUUID->"8e09d2e9-fa7d-4aa5-b9d4-e5c7c010e5bf"],
 " \[LineSeparator]",
 "writes it to ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"file", ".", "tex"}], "TI"]], "InlineFormula",ExpressionUUID->
  "082ffbfb-bc97-42f0-b5ec-a1113bc95278"],
 ".",
 Cell["   ", "ModInfo",ExpressionUUID->
  "6d893f3b-4e53-4c25-b43f-dae818c6382c"]
}], "Usage",
 CellID->904906237,ExpressionUUID->"696eafad-602e-40cd-ad28-8fec2723200f"],

Cell[TextData[{
 "The first argument may be a ",
 Cell[BoxData[
  TemplateBox[{
   "Notebook", "paclet:ref/Notebook", 
    "https://reference.wolfram.com/language/ref/Notebook.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "5176e559-8ef7-4976-80f6-90b5463b8245"],
 " expression or an open ",
 Cell[BoxData[
  TemplateBox[{
   "NotebookObject", "paclet:ref/NotebookObject", 
    "https://reference.wolfram.com/language/ref/NotebookObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "06f8fc83-ed0e-4980-b56f-a3f4ea4f290a"],
 "."
}], "Notes",
 CellID->719364571,ExpressionUUID->"f2be8231-3daa-4fec-a1db-6defa5c42ab6"],

Cell["\<\
The round trip is faithful because each cell carries the source whitespace \
that followed it as a tagging rule, so the export is a plain string join \
rather than a reconstruction.\
\>", "Notes",
 CellID->443203654,ExpressionUUID->"7eb56342-4967-4668-af17-2edfdf84c367"],

Cell["\<\
Only the recorded source is read, not the typeset boxes. A cell that renders \
wrongly still exports byte-identically, so a round trip cannot be used to \
detect a display defect.\
\>", "Notes",
 CellID->316027914,ExpressionUUID->"bd79233b-27f8-49b4-829e-0e5142a97c88"]
}, Open  ]],

