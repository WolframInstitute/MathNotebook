Cell["Read a LaTeX source file and write it straight back out:", "ExampleText",
 CellID->820968107,ExpressionUUID->"19bca91f-59df-42e9-a3d4-5425346154ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"file", "=", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"$TemporaryDirectory", ",", "\"\<sample.tex\>\""}], "}"}], 
      "]"}], ",", "\"\<\\\\section{Introduction}\\nLet $G = (V, E)$ be a \
graph with $|V| = n$ vertices.\\n\\n\\\\begin{theorem}\\nThe degree sum is \
$2|E|$.\\n\\\\end{theorem}\\n\>\"", ",", "\"\<Text\>\""}], "]"}]}], ";", 
  RowBox[{"nb", "=", 
   RowBox[{"ImportLaTeXDocument", "[", "file", "]"}]}], ";", 
  RowBox[{"ExportLaTeXDocument", "[", "nb", "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->383909052,ExpressionUUID->"55625198-9f12-4efa-a4a4-98b1cdbe0b20"],

