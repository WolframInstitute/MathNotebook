Notebook[{

Cell[CellGroupData[{
Cell["ConvertLaTeXCells", "ObjectName",
 CellID->155655367,ExpressionUUID->"e3aa7363-9379-4a37-b517-a4adc8a2ab00"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"be355a90-7b23-4e1d-9004-e416977b7aa2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertLaTeXCells",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertLaTeXCells"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "f39ac5b6-b1a5-4ccd-9c3d-b5341a56a579"],
 " \[LineSeparator]",
 "converts LaTeX math fragments in the selected cells into native typeset \
math, or in the whole input notebook if nothing is selected.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertLaTeXCells",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertLaTeXCells"], 
   RowBox[{"[", "notebook", "]"}]}]], "InlineFormula",ExpressionUUID->
  "eaa0a7e3-01bd-4460-bb07-c74ad44c9552"],
 " \[LineSeparator]",
 "converts the given notebook.",
 Cell["   ", "ModInfo",ExpressionUUID->"12e68e7a-8f43-4ed8-9e04-0b4d23f6920d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertLaTeXCells",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertLaTeXCells"], 
   RowBox[{"[", 
    RowBox[{"{", 
     RowBox[{"cell", ",", " ", "..."}], "}"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"3bd8f921-1a8b-4d7d-9c90-e1011909b920"],
 " \[LineSeparator]",
 "converts the given cells."
}], "Usage",
 CellID->544018715,ExpressionUUID->"7ae9be76-4e52-4980-b3e0-4955be04f0ea"],

Cell[TextData[{
 StyleBox["notebook",
  FontSlant->Italic],
 " is an open ",
 Cell[BoxData[
  TemplateBox[{
   "NotebookObject", "paclet:ref/NotebookObject", 
    "https://reference.wolfram.com/language/ref/NotebookObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "711c0591-bb30-4890-b28b-0c63a85854ad"],
 " and ",
 StyleBox["cell",
  FontSlant->Italic],
 " is a ",
 Cell[BoxData[
  TemplateBox[{
   "CellObject", "paclet:ref/CellObject", 
    "https://reference.wolfram.com/language/ref/CellObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "a3598c89-a941-4ce4-8e98-8b107a6188bd"],
 ", so every form acts on the front end. The function does nothing in a \
kernel with no front end."
}], "Notes",
 CellID->926789594,ExpressionUUID->"c17ee082-bfbd-4cd7-bcc5-c9c6049daf3f"],

Cell["\<\
A fragment that is a single Wolfram expression is parsed as one. Fragments \
that are not, such as a comma-separated pair or a cases environment, fall \
back to presentational boxes, which render correctly but carry no meaning.\
\>", "Notes",
 CellID->927505300,ExpressionUUID->"b4229208-5a8b-450f-8aa4-9c2753e331e3"],

Cell[TextData[{
 "The original source is recorded on each converted cell, so ",
 Cell[BoxData[
  TemplateBox[{
   "ConvertMathCells", 
    "paclet:WolframInstitute/MathNotebook/ref/ConvertMathCells", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
ConvertMathCells.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "12413895-115a-41db-94ec-e50bbc44a7e7"],
 " recovers it exactly."
}], "Notes",
 CellID->547229692,ExpressionUUID->"51e74fad-d613-47db-b097-875dda5a328c"],

Cell["\<\
A cell containing display math may become several cells, because display math \
glued into a paragraph is lifted into its own DisplayFormula cell.\
\>", "Notes",
 CellID->842185991,ExpressionUUID->"55665b9d-b8e5-4d31-a5e0-4ea896286eac"],

Cell["\<\
Cross-references written with \\ref and \\eqref are left as counter boxes \
rather than converted, since the surrounding text already names what is being \
referenced.\
\>", "Notes",
 CellID->544061550,ExpressionUUID->"286fcb3f-5252-4ae7-a040-822ad0fd970d"]
}, Open  ]],

