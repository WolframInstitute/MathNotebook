Notebook[{

Cell[CellGroupData[{
Cell["LabelReferences", "ObjectName",
 CellID->670813357,ExpressionUUID->"51c01dd9-2abd-4f6e-aa90-48a8eeabfc86"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2b6b5ad2-3322-4049-9e6b-1344951b67fc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["LabelReferences",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/LabelReferences"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "1a2c714c-46e5-42ae-b07a-470d1f286662"],
 " \[LineSeparator]",
 "labels every tagged Reference cell of the input notebook with its own tag, \
as the citations to it read, and clears the label of an untagged one.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["LabelReferences",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/LabelReferences"], 
   RowBox[{"[", "notebook", "]"}]}]], "InlineFormula",ExpressionUUID->
  "325d9015-fac7-4847-82e1-99fc9f44aac6"],
 " \[LineSeparator]",
 "labels the given notebook.",
 Cell["   ", "ModInfo",ExpressionUUID->
  "548340f0-14c0-489c-b2ae-29dd1b60dea8"]
}], "Usage",
 CellID->479195751,ExpressionUUID->"06e3ef0e-62cb-4b7e-9f8a-58cc5b5850db"],

Cell[TextData[{
 StyleBox["notebook",
  FontSlant->Italic],
 " is an open ",
 Cell[BoxData[
  TemplateBox[{
   "NotebookObject", "paclet:ref/NotebookObject", 
    "https://reference.wolfram.com/language/ref/NotebookObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "a4e4981d-2d03-43bc-8951-36ceadaa7df2"],
 ". The function acts on the front end and does nothing in a kernel with no \
front end."
}], "Notes",
 CellID->609592777,ExpressionUUID->"d5b47d6e-a5e8-463b-8d33-c357d130ddb8"],

Cell["\<\
The label is written into the cell rather than derived at display time, \
because a cell dingbat cannot read the options of the cell it labels.\
\>", "Notes",
 CellID->276415877,ExpressionUUID->"8d2acb53-ab2f-482c-8a83-b01976760ac6"],

Cell["\<\
Run it again after tagging or untagging Reference cells; it is idempotent and \
clears the label of any cell whose tag was removed.\
\>", "Notes",
 CellID->459525812,ExpressionUUID->"7823f9c1-a306-47aa-a8fd-c5f77adef720"]
}, Open  ]],

