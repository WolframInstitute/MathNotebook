Notebook[{

Cell[CellGroupData[{
Cell["InstallMaTeX", "ObjectName",
 CellID->48894163,ExpressionUUID->"f7a161df-18bd-41ed-8ec9-0b5dbbbce75c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d2895ccd-76bf-4346-a17b-f5f3cbfec5cd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["InstallMaTeX",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/InstallMaTeX"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "2800045d-b51b-44bf-ad15-b98f32ebe7c7"],
 " \[LineSeparator]",
 "installs and configures the MaTeX paclet."
}], "Usage",
 CellID->696548933,ExpressionUUID->"a376adf8-707e-4ac2-bb58-93828e083bfe"],

Cell["\<\
Downloads and installs MaTeX, then writes the paths to the local LaTeX \
distribution that MaTeX needs.\
\>", "Notes",
 CellID->664008314,ExpressionUUID->"15b47c6d-c757-4713-b9f2-5ac9fe5a448f"],

Cell["\<\
Requires network access and a LaTeX distribution such as TeX Live already \
present on the machine.\
\>", "Notes",
 CellID->803959350,ExpressionUUID->"fc337526-aa90-4a79-91e3-e40cf768bb10"],

Cell[TextData[{
 "The settings it writes can be inspected and edited afterwards with ",
 Cell[BoxData[
  TemplateBox[{
   "OpenMaTeXPreferences", 
    "paclet:WolframInstitute/MathNotebook/ref/OpenMaTeXPreferences", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
OpenMaTeXPreferences.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "5a39da8b-6daf-466b-a622-0ebdc768396f"],
 "."
}], "Notes",
 CellID->333224900,ExpressionUUID->"614f8021-fdd8-47b0-ab41-db769d673008"],

Cell[TextData[{
 "Run once per machine. It is only needed before ",
 Cell[BoxData[
  TemplateBox[{
   "ConvertToMaTeX", 
    "paclet:WolframInstitute/MathNotebook/ref/ConvertToMaTeX", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
ConvertToMaTeX.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "74aeeb5e-a32a-4ed2-b755-c48c2cb021c5"],
 " is used for the first time."
}], "Notes",
 CellID->290330444,ExpressionUUID->"e03225ef-be4a-4033-a6e9-c5169995c84e"]
}, Open  ]],

