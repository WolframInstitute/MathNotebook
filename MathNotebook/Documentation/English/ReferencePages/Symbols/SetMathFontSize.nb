Notebook[{

Cell[CellGroupData[{
Cell["SetMathFontSize", "ObjectName",
 CellID->544657443,ExpressionUUID->"7f24dcc4-056e-4451-824c-59683f216a0d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3af85723-dbec-46b7-80b3-b9f348ad97e8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SetMathFontSize",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/SetMathFontSize"], 
   RowBox[{"[", "size", "]"}]}]], "InlineFormula",ExpressionUUID->
  "a058cb94-8893-47b4-bd82-ea42fa9eeb92"],
 " \[LineSeparator]",
 "scales displayed mathematics and equation numbers of the input notebook to \
the font size ",
 Cell[BoxData[
  StyleBox["size", "TI"]], "InlineFormula",ExpressionUUID->
  "30e03b5f-8704-4550-b18a-eba969369df0"],
 ", re-rendering MaTeX cells.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["SetMathFontSize",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/SetMathFontSize"], 
   RowBox[{"[", 
    RowBox[{"notebook", ",", " ", "size"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"94f2468b-24b3-40d0-9220-da45239d3453"],
 " \[LineSeparator]",
 "scales the given notebook.",
 Cell["   ", "ModInfo",ExpressionUUID->"4478f84d-9b22-4027-9a6d-2d59726e166a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SetMathFontSize",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/SetMathFontSize"], 
   RowBox[{"[", 
    RowBox[{"notebook", ",", " ", "Automatic"}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"6c5b622e-da28-489e-a158-4a9ab93c79a8"],
 " \[LineSeparator]",
 "removes the override."
}], "Usage",
 CellID->66003414,ExpressionUUID->"07e24c4a-f674-4962-847c-6ee872145c5e"],

Cell[TextData[{
 StyleBox["notebook",
  FontSlant->Italic],
 " is an open ",
 Cell[BoxData[
  TemplateBox[{
   "NotebookObject", "paclet:ref/NotebookObject", 
    "https://reference.wolfram.com/language/ref/NotebookObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "3259df4e-9043-41d5-bf07-9b7005ca34da"],
 ", so the function acts on the front end and does nothing in a kernel with \
no front end."
}], "Notes",
 CellID->163278484,ExpressionUUID->"fdb9e1c4-6389-4da5-86d1-8ad815a8e984"],

Cell[TextData[{
 "MaTeX cells are images with their size baked in, so they are re-rendered \
rather than scaled. This needs a working MaTeX installation; see ",
 Cell[BoxData[
  TemplateBox[{
   "InstallMaTeX", "paclet:WolframInstitute/MathNotebook/ref/InstallMaTeX", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
InstallMaTeX.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "f2918bbc-8ad3-4b7a-b264-b87c43ea0803"],
 "."
}], "Notes",
 CellID->512718069,ExpressionUUID->"59cea0fd-9eea-4dd7-bafc-5998e694cc8f"],

Cell["\<\
Equation numbers are scaled along with the mathematics they label, so a \
numbered display stays visually balanced.\
\>", "Notes",
 CellID->938438304,ExpressionUUID->"293e0681-3411-4991-a80b-2063978a41d3"],

Cell[TextData[{
 "As with ",
 Cell[BoxData[
  TemplateBox[{
   "SetDocumentFontSize", 
    "paclet:WolframInstitute/MathNotebook/ref/SetDocumentFontSize", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
SetDocumentFontSize.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "7d47879d-e52b-4851-b8e4-ff9469c8907a"],
 ", the override is written for both the screen and the printout variant of \
each style, and installed as a private stylesheet."
}], "Notes",
 CellID->962097019,ExpressionUUID->"e242d786-6f20-420f-80f2-89a79f2a9bcf"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  TemplateBox[{
   "ResetDocumentView", 
    "paclet:WolframInstitute/MathNotebook/ref/ResetDocumentView", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
ResetDocumentView.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "83e60f43-0195-4b5e-826a-801a79e2049e"],
 " to remove this and every other view override at once."
}], "Notes",
 CellID->257085173,ExpressionUUID->"48df22ea-109f-4a43-bcb0-506c2e3236f5"]
}, Open  ]],

